---
/**
 * Technical side elevation of a backhoe loader in travel pose, with numbered
 * callouts. Drawn to the same proportions as the 3D model (100 px = 1 m).
 * Dimensions are the typical range for the 7–8 t class, not one model.
 */
interface Props { id?: string }
const { id = 'bhd' } = Astro.props;
const parts = [
  { n: 1, t: 'Loader bucket', d: 'Loads tippers, carries material, back-fills and levels. Roughly the width of the machine.', x: 746, y: 372 },
  { n: 2, t: 'Loader arms', d: 'Lift the bucket from ground level to tipper height.', x: 600, y: 238 },
  { n: 3, t: 'Operator cab', d: 'Seat swivels to face either end — one operator runs both tools.', x: 412, y: 150 },
  { n: 4, t: 'Stabilisers', d: 'Lowered before digging; they lift and steady the rear so the backhoe can work.', x: 248, y: 205 },
  { n: 5, t: 'Boom', d: 'Main digging arm; sets reach and depth together with the dipper.', x: 160, y: 120 },
  { n: 6, t: 'Dipper', d: 'Pulls the bucket through the cut. An extending dipper adds reach and depth.', x: 104, y: 160 },
  { n: 7, t: 'Backhoe bucket', d: 'Narrow digging bucket for trenches, footings and drains.', x: 120, y: 236 },
];
---
<figure class="bhd" aria-labelledby={`${id}-cap`}>
  <svg viewBox="40 0 830 470" role="img" aria-labelledby={`${id}-title`}>
    <title id={`${id}-title`}>Side elevation of a backhoe loader in travel position, with the loader bucket at the front and the folded backhoe at the rear.</title>
    <defs>
      <pattern id={`${id}-hatch`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="6" stroke="currentColor" stroke-width=".6" opacity=".35" /></pattern>
    </defs>
    <!-- ground -->
    <line x1="40" y1="400" x2="870" y2="400" class="g" />
    <rect x="40" y="400" width="830" height="10" fill={`url(#${id}-hatch)`} />
    <g class="m">
      <!-- chassis + rear frame -->
      <rect x="280" y="308" width="382" height="36" />
      <rect x="253" y="274" width="70" height="62" />
      <!-- hood -->
      <path d="M495 308 H660 L670 276 L662 248 L640 238 L495 226 Z" class="paint" />
      <line x1="668" y1="290" x2="668" y2="252" class="thin" />
      <!-- cab -->
      <path d="M318 101 H506 L510 108 L502 114 H322 L316 108 Z" />
      <path d="M330 114 H495 V305 H330 Z" />
      <path d="M338 122 H410 V258 H338 Z M418 122 H488 V258 H418 Z" class="glass" />
      <!-- exhaust -->
      <rect x="527" y="168" width="9" height="60" />
      <!-- fenders -->
      <path d="M300 300 A80 80 0 0 1 452 290" class="paint-l" />
      <path d="M552 318 A62 62 0 0 1 648 316" class="paint-l" />
      <!-- wheels -->
      <circle cx="375" cy="332" r="68" class="tyre" />
      <circle cx="375" cy="332" r="40" class="paint" />
      <circle cx="375" cy="332" r="14" />
      <circle cx="600" cy="350" r="50" class="tyre" />
      <circle cx="600" cy="350" r="28" class="paint" />
      <circle cx="600" cy="350" r="10" />
      <!-- loader arm (lowered) -->
      <path d="M462 266 L550 238 L632 236 L692 296 L728 352 L712 362 L676 306 L626 252 L552 254 L466 280 Z" class="paint" />
      <circle cx="470" cy="270" r="6" />
      <!-- lift ram -->
      <line x1="545" y1="306" x2="590" y2="254" class="ram" />
      <!-- loader bucket -->
      <path d="M714 318 L698 362 L702 388 L716 400 L804 400 L772 366 L738 322 Z" class="paint" />
      <line x1="714" y1="400" x2="808" y2="400" class="edge" />
      <!-- stabiliser (stowed) -->
      <rect x="242" y="168" width="14" height="124" class="paint" />
      <rect x="236" y="160" width="26" height="8" />
      <!-- kingpost -->
      <rect x="214" y="262" width="34" height="80" />
      <!-- boom (raised) -->
      <path d="M214 270 L190 190 L150 90 L112 20 L128 16 L170 84 L216 188 L232 262 Z" class="paint" />
      <!-- boom ram -->
      <line x1="232" y1="320" x2="198" y2="200" class="ram" />
      <!-- dipper (folded) -->
      <path d="M118 22 L98 30 L94 210 L108 214 L114 40 Z" class="paint" />
      <line x1="142" y1="60" x2="112" y2="28" class="ram" />
      <!-- backhoe bucket (curled) -->
      <path d="M96 206 L132 214 L150 240 L140 262 L112 252 L94 230 Z" class="paint" />
      <circle cx="120" cy="20" r="5" />
      <circle cx="101" cy="210" r="4" />
    </g>

    <!-- dimensions -->
    <g class="dim">
      <line x1="94" y1="436" x2="804" y2="436" />
      <line x1="94" y1="428" x2="94" y2="444" /><line x1="804" y1="428" x2="804" y2="444" />
      <text x="447" y="458" text-anchor="middle">Transport length ≈ 5.6–6.0 m</text>
      <line x1="846" y1="14" x2="846" y2="400" />
      <line x1="838" y1="14" x2="854" y2="14" /><line x1="838" y1="400" x2="854" y2="400" />
      <line x1="128" y1="14" x2="838" y2="14" class="dash" />
      <text x="836" y="200" text-anchor="end">Travel height</text>
      <text x="836" y="216" text-anchor="end">≈ 3.5–3.9 m</text>
      <line x1="375" y1="380" x2="600" y2="380" class="dash" />
      <text x="488" y="392" text-anchor="middle" class="sm">Wheelbase ≈ 2.2 m</text>
    </g>

    <!-- callouts -->
    <g class="co">
      {parts.map((p) => (
        <g>
          <circle cx={p.x} cy={p.y} r="11" />
          <text x={p.x} y={p.y + 4} text-anchor="middle">{p.n}</text>
        </g>
      ))}
    </g>
  </svg>
  <figcaption id={`${id}-cap`}>
    <ol class="bhd__list">
      {parts.map((p) => <li><b>{p.t}</b><span>{p.d}</span></li>)}
    </ol>
    <p class="bhd__note mono">Dimensions show typical ranges for 7–8 t class backhoe loaders — general industry information, not a particular RBE machine. The machine offered for your project, and its specification, is stated in the quote.</p>
  </figcaption>
</figure>

<style>
  .bhd { margin: 0; display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 64px); align-items: center; color: var(--on-dark); }
  svg { width: 100%; height: auto; overflow: visible; }
  .g { stroke: var(--on-dark-2); stroke-width: 1; }
  .m * { fill: rgba(238,235,229,.04); stroke: var(--on-dark); stroke-width: 1.15; stroke-linejoin: round; }
  .m .paint { fill: rgba(196,105,44,.22); stroke: var(--copper-hi); }
  .m .paint-l { fill: none; stroke: var(--copper-hi); stroke-width: 6; }
  .m .glass { fill: rgba(141,148,155,.12); stroke: var(--on-dark-2); }
  .m .tyre { fill: rgba(14,16,18,.9); stroke: var(--on-dark-2); stroke-width: 1.15; stroke-dasharray: 3 3; }
  .m .ram { stroke: #d9dcdf; stroke-width: 5; stroke-linecap: round; }
  .m .thin { stroke-width: .6; }
  .m .edge { stroke: #d9dcdf; stroke-width: 3; }
  .dim line { stroke: var(--on-dark-2); stroke-width: .8; }
  .dim .dash { stroke-dasharray: 4 4; }
  .dim text { fill: var(--on-dark-2); font-family: var(--f-mono); font-size: 13px; letter-spacing: .04em; }
  .dim text.sm { font-size: 11px; }
  .co circle { fill: var(--copper); stroke: var(--ink); stroke-width: 2; }
  .co text { fill: var(--ink); font-family: var(--f-mono); font-size: 12px; font-weight: 500; }
  .bhd__list { list-style: none; counter-reset: c; margin: 0; padding: 0; display: grid; gap: 0; }
  .bhd__list li { counter-increment: c; display: grid; grid-template-columns: 34px 1fr; column-gap: 8px; padding: 12px 0; border-bottom: 1px solid var(--line-d); font-size: .94rem; }
  .bhd__list li::before { content: counter(c); grid-row: span 2; width: 22px; height: 22px; border-radius: 50%; background: var(--copper); color: var(--ink); display: grid; place-items: center; font-family: var(--f-mono); font-size: .72rem; font-weight: 500; }
  .bhd__list b { font-weight: 600; }
  .bhd__list span { color: var(--on-dark-2); }
  .bhd__note { margin-top: 20px; font-size: .75rem; color: var(--on-dark-2); line-height: 1.6; }
  @media (max-width: 960px) { .bhd { grid-template-columns: 1fr; } }
</style>

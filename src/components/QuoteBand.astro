---
import Icon from './Icon.astro';
import { site, tel, wa } from '../data/site';
interface Props { heading?: string; text?: string; waText?: string }
const {
  heading = 'Tell us where the site is and when you need to start.',
  text = 'Send the project location, type of work, start date and how long you need the machine (15 days minimum). RBE confirms availability, how the machine reaches your site and the full terms in writing — operator included.',
  waText,
} = Astro.props;
---
<section class="qb dark" aria-label="Request a quote">
  <div class="wrap qb__in">
    <div>
      <p class="eyebrow"><span class="idx">→</span> Check availability</p>
      <h2 class="qb__h">{heading}</h2>
    </div>
    <div class="qb__r">
      <p class="muted">{text}</p>
      <div class="btn-row">
        <a class="btn" href="/contact/">Request a rental quote <Icon name="arrow" /></a>
        <a class="btn btn--wa" href={wa(waText)} rel="noopener"><Icon name="wa" />WhatsApp</a>
        <a class="btn btn--ghost" href={tel}><Icon name="phone" />{site.phoneDisplay}</a>
      </div>
      <p class="mono qb__hrs"><Icon name="clock" />Enquiry hours · {site.hours}</p>
    </div>
  </div>
</section>
<style>
  .qb { padding-block: clamp(72px, 9vw, 128px); border-top: 1px solid var(--line-d); position: relative; overflow: hidden; }
  .qb::before { content: ''; position: absolute; right: -10%; top: -40%; width: 60%; aspect-ratio: 1; background: radial-gradient(closest-side, rgba(196,105,44,.18), transparent); pointer-events: none; }
  .qb__in { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: end; position: relative; }
  .qb__h { font-size: clamp(2rem, 4vw, 3.4rem); max-width: 18ch; }
  .qb__r p { margin-bottom: 28px; max-width: 46ch; }
  .qb__hrs { display: flex; align-items: center; gap: 8px; margin: 20px 0 0 !important; font-size: .75rem; letter-spacing: .04em; color: var(--on-dark-2); }
  .qb__hrs :global(svg) { width: 16px; }
  @media (max-width: 900px) { .qb__in { grid-template-columns: 1fr; } }
</style>

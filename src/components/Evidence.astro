---
/**
 * A real site photograph presented as evidence: fixed aspect ratio (no layout
 * shift), responsive AVIF/WebP, lazy-loaded, with a factual caption line.
 */
import { Picture } from 'astro:assets';
import type { Photo } from '../data/media';
import { cases } from '../data/cases';
interface Props { photo: Photo; ratio?: string; sizes?: string; note?: string; tone?: 'dark' | 'light'; eager?: boolean; pos?: string; short?: boolean }
const { photo, ratio = '3 / 2', sizes = '(max-width: 860px) 100vw, 50vw', note, tone = 'light', eager = false, pos = '50% 50%', short = false } = Astro.props;
const c = cases.find((x) => x.id === photo.project)!;
---
<figure class={`ev ev--${tone}`}>
  <div class="ev__frame" style={`aspect-ratio:${ratio};--pos:${pos}`}>
    <Picture src={photo.src} alt={photo.alt} formats={['avif', 'webp']} widths={[480, 800, 1200, 1600]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} decoding="async" quality={55} />
  </div>
  <figcaption class="mono">
    <span class="ev__tag">Real site</span>
    <span>{short ? (photo.taken ?? 'Same site') : `${c.name} · ${c.work} · ${c.district} district${photo.taken ? ` · ${photo.taken}` : ''}`}</span>
    {note && <span class="ev__note">{note}</span>}
  </figcaption>
</figure>
<style>
  .ev { margin: 0; }
  .ev__frame { position: relative; overflow: hidden; background: var(--ink-3); }
  .ev__frame :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); display: block; }
  figcaption { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; margin-top: 12px; font-size: .72rem; letter-spacing: .04em; color: var(--on-light-2); }
  .ev--dark figcaption { color: var(--on-dark-2); }
  .ev__tag { text-transform: uppercase; letter-spacing: .14em; color: var(--copper-lo); }
  .ev--dark .ev__tag { color: var(--copper-hi); }
  .ev__note { flex-basis: 100%; font-family: var(--f-ui); font-size: .9rem; letter-spacing: 0; color: inherit; }
</style>

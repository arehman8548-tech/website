---
/**
 * Engineering cross-sections for each project type. Copper = the work a
 * backhoe loader typically does in that section. Schematic, not to scale.
 */
interface Props { kind: 'road' | 'hill' | 'site' | 'bridge' | 'trench' | 'plains'; label: string }
const { kind, label } = Astro.props;
---
<svg class="pd" viewBox="0 0 400 220" role="img" aria-label={label}>
  <defs>
    <pattern id={`pd-h-${kind}`} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="5" stroke="currentColor" stroke-width=".6" opacity=".4" /></pattern>
  </defs>
  {kind === 'road' && (
    <g>
      <path d="M0 40 L70 60 L110 128 L118 150 H300 L400 210 V220 H0 Z" fill={`url(#pd-h-${kind})`} class="s" />
      <path d="M95 104 L110 128 L118 150" class="w" />
      <path d="M118 150 H128 L132 162 H140 L144 150" class="w" />
      <line x1="150" y1="150" x2="290" y2="150" class="k" />
      <rect x="288" y="138" width="10" height="12" class="k" />
      <text x="128" y="182" class="t">side drain</text>
      <text x="198" y="142" class="t" text-anchor="middle">carriageway</text>
      <text x="62" y="100" class="t" text-anchor="end">cut edge</text>
      <text x="304" y="132" class="t">parapet</text>
    </g>
  )}
  {kind === 'hill' && (
    <g>
      <path d="M0 30 L60 40 L120 70 L120 96 L170 96 L170 122 L220 122 L220 150 L400 150 V220 H0 Z" fill={`url(#pd-h-${kind})`} class="s" />
      <path d="M120 70 L180 40 L260 60 L330 100 L400 150" class="g" />
      <path d="M120 70 L120 96 L170 96 L170 122 L220 122 L220 150" class="w" />
      <text x="226" y="112" class="t">benched cut</text>
      <text x="300" y="80" class="t">original slope</text>
      <path d="M124 92 h40 M174 118 h40" class="d" />
      <text x="40" y="200" class="t">drain each bench before the monsoon</text>
    </g>
  )}
  {kind === 'site' && (
    <g>
      <path d="M0 50 L80 70 L80 110 L220 110 L220 150 L400 160 V220 H0 Z" fill={`url(#pd-h-${kind})`} class="s" />
      <rect x="72" y="70" width="12" height="40" class="k" />
      <rect x="212" y="110" width="12" height="40" class="k" />
      <path d="M90 110 v14 h22 v-14 M150 110 v14 h22 v-14" class="w" />
      <path d="M80 70 L80 110 L220 110 L220 150" class="w2" />
      <text x="96" y="140" class="t">footings</text>
      <text x="30" y="60" class="t">retaining wall</text>
      <text x="240" y="140" class="t">terraced plot</text>
    </g>
  )}
  {kind === 'bridge' && (
    <g>
      <path d="M0 80 L110 80 L140 170 L260 170 L290 80 L400 80 V220 H0 Z" fill={`url(#pd-h-${kind})`} class="s" />
      <path d="M140 170 Q200 182 260 170" class="water" />
      <path d="M150 165 Q200 176 250 165" class="water" />
      <rect x="92" y="60" width="26" height="60" class="k" />
      <rect x="282" y="60" width="26" height="60" class="k" />
      <line x1="80" y1="60" x2="320" y2="60" class="k" />
      <path d="M84 120 v16 h42 v-16 M274 120 v16 h42 v-16" class="w" />
      <path d="M0 80 H84 M316 80 H400" class="w" />
      <text x="40" y="150" class="t">abutment pit</text>
      <text x="330" y="105" class="t">approach fill</text>
    </g>
  )}
  {kind === 'trench' && (
    <g>
      <path d="M0 80 H150 V190 H250 V80 H400 V220 H0 Z" fill={`url(#pd-h-${kind})`} class="s" />
      <path d="M150 80 V190 H250 V80" class="w" />
      <circle cx="200" cy="165" r="20" class="k" />
      <path d="M160 188 H240" class="k" />
      <path d="M270 80 Q300 50 330 80" class="w2" />
      <text x="282" y="48" class="t">spoil</text>
      <text x="258" y="140" class="t">pipe / cable bedding</text>
      <path d="M140 80 v110" class="d" /><text x="134" y="140" class="t" text-anchor="end">depth</text>
    </g>
  )}
  {kind === 'plains' && (
    <g>
      <path d="M0 120 H400 V220 H0 Z" fill={`url(#pd-h-${kind})`} class="s" />
      <path d="M0 112 Q60 98 120 114 T240 108 T400 116" class="g" />
      <path d="M0 120 H400" class="w" />
      <path d="M40 120 v20 h30 v-20 M170 120 v20 h30 v-20 M300 120 v20 h30 v-20" class="w" />
      <path d="M90 120 v34 h16 v-34" class="w" />
      <text x="40" y="96" class="t">existing ground</text>
      <text x="120" y="176" class="t">graded level · footings · services</text>
    </g>
  )}
</svg>
<style>
  .pd { width: 100%; height: auto; display: block; color: currentColor; }
  .s { stroke: currentColor; stroke-width: 1; stroke-opacity: .6; }
  .g { fill: none; stroke: currentColor; stroke-width: 1; stroke-dasharray: 3 4; opacity: .55; }
  .k { fill: none; stroke: currentColor; stroke-width: 1.4; }
  .w { fill: none; stroke: var(--copper); stroke-width: 2.6; stroke-linejoin: round; stroke-linecap: round; }
  .w2 { fill: rgba(196,105,44,.18); stroke: var(--copper); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .d { stroke: currentColor; stroke-width: .8; stroke-dasharray: 2 3; opacity: .7; fill: none; }
  .water { fill: none; stroke: #7f97ab; stroke-width: 1.4; }
  .t { fill: currentColor; font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .03em; opacity: .85; }
</style>

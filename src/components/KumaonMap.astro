---
/**
 * Schematic map of the Kumaon locations we support, projected from
 * approximate lat/long. Connections are schematic, not road alignments.
 */
import { places, belts, type Belt } from '../data/geo';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const LON0 = 78.82, LAT0 = 30.0, K = 520, COS = Math.cos((29.5 * Math.PI) / 180);
const r1 = (v: number) => Math.round(v * 10) / 10;
const px = (lon: number) => r1((lon - LON0) * K * COS + 40);
const py = (lat: number) => r1((LAT0 - lat) * K + 30);
const P = Object.fromEntries(places.map((p) => [p.slug, { ...p, x: px(p.lon), y: py(p.lat) }]));
const links: [string, string][] = [
  ['kashipur', 'rudrapur'], ['rudrapur', 'pantnagar'], ['pantnagar', 'haldwani'], ['rudrapur', 'haldwani'], ['haldwani', 'kathgodam'],
  ['kathgodam', 'bhimtal'], ['kathgodam', 'bhowali'], ['bhowali', 'nainital'], ['bhowali', 'ramgarh'], ['ramgarh', 'mukteshwar'],
  ['bhowali', 'almora'], ['bhowali', 'ranikhet'], ['ranikhet', 'almora'], ['almora', 'bageshwar'], ['bageshwar', 'berinag'], ['almora', 'berinag'],
];
const beltColor: Record<Belt, string> = { plains: 'var(--steel)', midhills: 'var(--copper-hi)', innerhills: '#e9d3b8' };
const labelSide: Record<string, 'l' | 'r' | 'b' | 't'> = { kashipur: 'l', rudrapur: 'b', pantnagar: 'r', haldwani: 'l', kathgodam: 'r', bhimtal: 'r', bhowali: 'r', nainital: 'l', ramgarh: 't', mukteshwar: 'r', ranikhet: 'l', almora: 'b', bageshwar: 't', berinag: 'r' };
const W = Math.ceil(px(80.25)) , H = Math.ceil(py(28.9));
const km50 = (50 / 111) * K * COS; // ≈50 km horizontal at this latitude
---
<figure class={`kmap ${compact ? 'kmap--c' : ''}`}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="kmap-t">
    <title id="kmap-t">Schematic map of Kumaon showing supported locations from Kashipur and Rudrapur in the plains to Nainital, Almora, Bageshwar and Berinag in the hills.</title>
    <defs>
      <pattern id="kgrid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="currentColor" stroke-width=".5" opacity=".14" /></pattern>
      <linearGradient id="kband" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#8d949b" stop-opacity=".09" /><stop offset=".45" stop-color="#c4692c" stop-opacity=".07" /><stop offset="1" stop-color="#e9d3b8" stop-opacity=".06" /></linearGradient>
    </defs>
    <rect width={W} height={H} fill="url(#kgrid)" />
    <rect width={W} height={H} fill="url(#kband)" />
    <!-- terrain belts (schematic): the Shivalik foothill line runs just north of Haldwani -->
    <path d={`M0 ${py(29.3)} C ${px(79.2)} ${py(29.28)}, ${px(79.6)} ${py(29.3)}, ${W} ${py(29.22)}`} class="belt" />
    <path d={`M0 ${py(29.56)} C ${px(79.3)} ${py(29.55)}, ${px(79.7)} ${py(29.53)}, ${W} ${py(29.5)}`} class="belt" />
    <text x="14" y={py(29.3) + 22} class="bl">TERAI &amp; PLAINS</text>
    <text x="14" y={py(29.56) + 22} class="bl">MID-HILLS</text>
    <text x="14" y={py(29.56) - 12} class="bl">INNER HILLS</text>
    {links.map(([a, b]) => <line x1={P[a].x} y1={P[a].y} x2={P[b].x} y2={P[b].y} class="ln" />)}
    {places.map((p) => {
      const q = P[p.slug];
      const side = labelSide[p.slug] ?? 'r';
      const dx = side === 'l' ? -12 : side === 'r' ? 12 : 0;
      const dy = side === 'b' ? 20 : side === 't' ? -12 : 4;
      const anchor = side === 'l' ? 'end' : side === 'r' ? 'start' : 'middle';
      return (
        <g class="pt" data-place={p.slug}>
          <circle cx={q.x} cy={q.y} r="11" class="halo" />
          <circle cx={q.x} cy={q.y} r="4.5" fill={beltColor[p.belt]} />
          <text x={q.x + dx} y={q.y + dy} text-anchor={anchor}>{p.name}</text>
        </g>
      );
    })}
    <!-- scale + north -->
    <g class="sc" transform={`translate(${W - km50 - 30}, ${H - 34})`}>
      <line x1="0" y1="0" x2={km50} y2="0" /><line x1="0" y1="-5" x2="0" y2="5" /><line x1={km50} y1="-5" x2={km50} y2="5" />
      <text x={km50 / 2} y="-9" text-anchor="middle">≈ 50 km</text>
    </g>
    <g class="sc" transform={`translate(${W - 34}, 40)`}>
      <path d="M0 -16 L6 6 L0 2 L-6 6 Z" class="n" /><text x="0" y="22" text-anchor="middle">N</text>
    </g>
  </svg>
  <figcaption class="mono">
    <span><i style="background:var(--steel)"></i>{belts.plains.title}</span>
    <span><i style="background:var(--copper-hi)"></i>{belts.midhills.title}</span>
    <span><i style="background:#e9d3b8"></i>{belts.innerhills.title}</span>
    <span class="kmap__n">Schematic — positions approximate, lines are not road alignments.</span>
  </figcaption>
</figure>

<style>
  .kmap { margin: 0; color: var(--on-dark); }
  svg { width: 100%; height: auto; display: block; border: 1px solid var(--line-d); }
  .belt { fill: none; stroke: var(--on-dark-2); stroke-width: .8; stroke-dasharray: 2 5; opacity: .6; }
  .bl { fill: var(--on-dark-2); font-family: var(--f-mono); font-size: 10px; letter-spacing: .16em; opacity: .7; }
  .ln { stroke: var(--on-dark-2); stroke-width: .9; opacity: .45; }
  .pt text { fill: var(--on-dark); font-family: var(--f-ui); font-size: 13px; font-weight: 500; paint-order: stroke; stroke: var(--ink); stroke-width: 4px; stroke-linejoin: round; }
  .pt .halo { fill: var(--copper); opacity: 0; transition: opacity .3s var(--ease); }
  .pt.is-hot .halo { opacity: .35; }
  .pt.is-hot text { fill: var(--copper-hi); }
  .sc line { stroke: var(--on-dark-2); stroke-width: 1; }
  .sc text { fill: var(--on-dark-2); font-family: var(--f-mono); font-size: 10px; }
  .sc .n { fill: var(--on-dark-2); }
  figcaption { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 14px; font-size: .7rem; letter-spacing: .06em; color: var(--on-dark-2); }
  figcaption span { display: inline-flex; align-items: center; gap: 8px; }
  figcaption i { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .kmap__n { flex-basis: 100%; opacity: .75; }
</style>

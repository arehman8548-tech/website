---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found | RBE Capital Equip." description="This page does not exist." noindex>
  <section class="phero" style="min-height:80vh">
    <div class="wrap">
      <p class="eyebrow"><span class="idx">404</span>Page not found</p>
      <h1>This road <span class="serif">doesn’t go through.</span></h1>
      <p class="lead">The page you were looking for isn’t here. These will get you back on route:</p>
      <div class="btn-row">
        <a class="btn" href="/contact/">Check availability <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href="/backhoe-loader-rental/">Backhoe loader rental</a>
        <a class="btn btn--ghost" href="/knowledge/">Questions & answers</a>
      </div>
    </div>
  </section>
</Base>

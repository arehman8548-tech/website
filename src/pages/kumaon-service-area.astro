---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ScrollStage, { type Chapter } from '../components/ScrollStage.astro';
import QuoteBand from '../components/QuoteBand.astro';
import NextSteps from '../components/NextSteps.astro';
import Icon from '../components/Icon.astro';
import { belts, places, allPlaces, districts, type Belt } from '../data/geo';
import { projects } from '../data/projects';
import { qa } from '../data/faq';
import { breadcrumbs } from '../data/schema';
import { wa, site } from '../data/site';

const crumbs = [{ name: 'Kumaon Service Area', href: '/kumaon-service-area/' }];
const title = 'JCB Hire from Haldwani to Nainital, Almora & Bageshwar | RBE';
const description =
  'From our Haldwani and Majkhali (Ranikhet) bases to Nainital, Almora and Bageshwar: how terrain, access and season shape getting a backhoe loader to your site.';
const order: Belt[] = ['plains', 'midhills', 'innerhills'];
const projFor = (slug: string) => projects.filter((p) => p.where.includes(slug)).slice(0, 2);
const remote = qa('remote');
const selfDrive = qa('self-drive');
const alt = (slug: string) => places.find((p) => p.slug === slug)!.altM.toLocaleString('en-IN');
const names = (b: Belt) => places.filter((p) => p.belt === b).map((p) => `${p.name} (${p.altM.toLocaleString('en-IN')} m)`).join(', ');

const chapters: Chapter[] = [
  { k: 'Deployment base', h: 'Machines leave from Haldwani, where the plains meet the hills.', p: `Haldwani (about ${alt('haldwani')} m) sits at the foot of the Kumaon hills, beside the Kathgodam railhead where the hill roads begin. Sites in the plains and lake district are planned from here; RBE’s second base at Majkhali, near Ranikhet, serves the inner hills.`, still: '/scenes/kumaon-0.jpg', alt: '3D terrain map looking north from Haldwani across the plains to the first ridges of the Kumaon hills.' },
  { k: 'The network', h: 'From Haldwani, routes into every belt of Kumaon.', p: `Kumaon is the eastern division of Uttarakhand — ${districts.join(', ')} districts. From Haldwani, machines reach the plains, the lake district and the inner hills.`, still: '/scenes/kumaon-1.jpg', alt: '3D terrain map of Kumaon with backhoe loader rental delivery routes running from Haldwani to the hill towns served.' },
  { k: 'Terai & plains', h: belts.plains.title + '.', p: `${names('plains')}. ${belts.plains.realities[0]}`, still: '/scenes/kumaon-2.jpg', alt: '3D terrain map of the Terai plains showing routes from Haldwani to Pantnagar, Rudrapur and Kashipur.' },
  { k: 'Mid-hills', h: belts.midhills.title + '.', p: `${names('midhills')}. ${belts.midhills.realities[0]}`, still: '/scenes/kumaon-3.jpg', alt: '3D terrain map of the Nainital lake district hills with routes to Bhimtal, Bhowali, Nainital, Ramgarh and Mukteshwar.' },
  { k: 'Inner hills', h: belts.innerhills.title + '.', p: `${names('innerhills')}. ${belts.innerhills.realities[0]}`, still: '/scenes/kumaon-4.jpg', alt: '3D terrain map of the inner Kumaon hills with routes to Almora, Bageshwar and Berinag.' },
  { k: 'Your site', h: 'Nearly two thousand metres of difference in one region.', p: 'Altitude brings narrower roads, steeper plots, colder mornings and longer travel. Send the site location and we will plan how the machine gets there.', cta: true, still: '/scenes/kumaon-5.jpg', alt: '3D terrain map of the full Kumaon service area, with routes from Haldwani to towns across the plains and hills.' },
];
---
<Base title={title} description={description} schema={[breadcrumbs(crumbs)]}>
  <PageHero crumbs={crumbs} eyebrow="Service area · Kumaon, Uttarakhand">
    <h1>Backhoe loaders across Kumaon — <span class="serif">Terai to high ridges.</span></h1>
    <p class="lead">Rudrapur and Haldwani sit a few hundred metres above sea level. Mukteshwar is over 2,000 m. The same machine works in both — but getting it there is planned differently. That is why RBE dispatches from two bases: Haldwani at the foot of the hills, and Majkhali near Ranikhet, inside them.</p>
  </PageHero>

  <section class="section dark" aria-labelledby="h-map">
    <div class="wrap mapgrid">
      <div>
        <p class="eyebrow"><span class="idx">01</span>Where we deploy</p>
        <h2 id="h-map">Two deployment bases. <span class="serif">Sites across six districts.</span></h2>
        <div class="prose muted" style="margin-top:24px">
          <p>Kumaon is the eastern division of Uttarakhand, made up of six districts: {districts.join(', ')}. The machine is dispatched from <a href="#haldwani">Haldwani</a> (Nainital district) and <a href="#majkhali">Majkhali</a> (near Ranikhet, Almora district), and works on project sites around the towns below.</p>
          <p>A site does not need to be <em>in</em> one of these towns. If it is a village road above Bageshwar or a resort plot beyond Ramgarh, <a href="/contact/">send the location</a> and we will plan from there.</p>
        </div>
      </div>
      <ul class="plist" data-plist aria-label="Locations we deploy to">
        {allPlaces.map((p) => <li><a href={`#${p.slug}`}>{p.name}<span class="mono">{p.altM.toLocaleString('en-IN')} m</span></a></li>)}
      </ul>
    </div>
  </section>

  <ScrollStage
    scene="kumaon"
    id="network"
    label="Three-dimensional terrain model of Kumaon showing the Haldwani deployment base and the service network"
    chapters={chapters}
    len={115}
    caption="Terrain: SRTM elevation, vertical scale ×2.2 · Boundaries: Census of India 2011 districts · Corridors are indicative, not road alignments"
    ctaWa={wa('Hello RBE Capital Equip., sharing my site location for backhoe loader mobilisation: ')}
  >
    <div class="klabels" slot="overlay" aria-hidden="true">
      {places.map((p) => (
        <span class={`kl${p.slug === 'haldwani' ? ' kl--base' : ''}`} data-label={p.slug} data-w={Math.max(p.name.length * 9 + 28, p.slug === 'haldwani' ? 170 : 0)}>
          <b>{p.name}</b><i>{p.slug === 'haldwani' ? 'Machine deployment base' : `${p.altM.toLocaleString('en-IN')} m · ${p.district}`}</i>
        </span>
      ))}
    </div>
  </ScrollStage>

  {order.map((b, bi) => {
    const B = belts[b];
    const ps = allPlaces.filter((p) => p.belt === b);
    return (
      <section class={`section belt ${bi % 2 ? 'stone' : 'paper'}`} id={`belt-${b}`} aria-labelledby={`h-${b}`}>
        <div class="wrap">
          <div class="belt__head">
            <p class="eyebrow"><span class="idx">0{bi + 3}</span>{B.short}</p>
            <h2 id={`h-${b}`}>{B.title}</h2>
          </div>
          <div class="belt__grid">
            <div>
              <h3>Site realities</h3>
              <ul class="belt__list">{B.realities.map((r) => <li>{r}</li>)}</ul>
            </div>
            <div>
              <h3>Typical work here</h3>
              <ul class="belt__list belt__list--w">{B.work.map((r) => <li>{r}</li>)}</ul>
            </div>
          </div>
          <div class="pcards">
            {ps.map((p) => (
              <article class="pcard" id={p.slug} aria-labelledby={`${p.slug}-h`}>
                {p.base && <p class="mono pcard__base">RBE deployment base</p>}
                <div class="pcard__top">
                  <h3 id={`${p.slug}-h`}>{p.name}</h3>
                  <span class="mono">{p.altM.toLocaleString('en-IN')} m</span>
                </div>
                <p class="mono pcard__d">{p.district} district</p>
                <p>{p.note}</p>
                <p class="pcard__links">
                  {projFor(p.slug).map((pr) => <a class="inline" href={`/project-solutions/#${pr.id}`}>{pr.title.split(' &')[0].split(',')[0]}</a>)}
                </p>
                <a class="pcard__wa" href={wa(`Hello RBE Capital Equip., I need a backhoe loader with operator near ${p.name}.\nProject / type of work:\nStart date:\nDuration (15 days minimum):`)} rel="noopener"><Icon name="wa" />Backhoe loader near {p.name}</a>
              </article>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <section class="section dark" id="deployment" aria-labelledby="h-dep">
    <div class="wrap dep">
      <div>
        <p class="eyebrow"><span class="idx">06</span>Deployment planning</p>
        <h2 id="h-dep">What decides how fast a machine <span class="serif">reaches your site.</span></h2>
        <div class="answer" style="margin-top:32px">
          <h3>{remote.q}</h3>
          <p class="muted">{remote.a}</p>
        </div>
        <div class="answer">
          <h3>{selfDrive.q}</h3>
          <p class="muted">{selfDrive.a}</p>
        </div>
      </div>
      <div>
        <ol class="factors">
          <li><b>Availability on your date</b><span>Confirmed first — before anything else is planned.</span></li>
          <li><b>Which base, and the route</b><span>From Haldwani or from Majkhali (Ranikhet); which road, and how long it takes.</span></li>
          <li><b>Access road condition</b><span>Width, hairpin bends, gradient and the last-mile surface to the plot.</span></li>
          <li><b>Travel method</b><span>On its own wheels or on a trailer, depending on distance and route.</span></li>
          <li><b>Season</b><span>Monsoon slips and closures, and snow on higher sites in winter, mean earlier mobilisation and buffer.</span></li>
          <li><b>Stay and supplies</b><span>Overnight parking, diesel and operator accommodation at remote sites.</span></li>
        </ol>
        <div class="btn-row" style="margin-top:36px">
          <a class="btn" href="/contact/">Send your site location <Icon name="arrow" /></a>
          <a class="btn btn--wa" href={wa('Hello RBE Capital Equip., sharing my site location for backhoe loader mobilisation (map pin below).\nAccess road:\nType of work:\nStart date / duration:')} rel="noopener"><Icon name="wa" />Share a map pin</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section paper" id="outside" aria-labelledby="h-out">
    <div class="wrap out">
      <div>
        <p class="eyebrow"><span class="idx">07</span>New to Kumaon?</p>
        <h2 id="h-out">Executing a project here from outside the state.</h2>
      </div>
      <div class="prose">
        <p class="lead" style="max-width:none">Many contracts in Kumaon are won by companies based elsewhere. The work is familiar; the terrain, routes and seasons often are not.</p>
        <ul>
          <li><strong>The plains are the gateway.</strong> Haldwani and Kathgodam are where the hill roads begin. Plan site visits and mobilisation through them.</li>
          <li><strong>Hill distances are measured in hours, not kilometres.</strong> A move that looks short on a map can take a full day on mountain roads.</li>
          <li><strong>The monsoon reshapes the programme.</strong> From about June to September, slips and closures are normal. Front-load earthwork and drainage before the rains where you can.</li>
          <li><strong>Arrange equipment before you need it.</strong> A machine that is free at short notice in the plains is rarely free at short notice at a remote hill site.</li>
          <li><strong>Hourly hire does not travel well.</strong> Hill mobilisation takes time, which is why RBE rents for 15 days or more and always with an operator.</li>
        </ul>
        <p>RBE’s head office is in {site.headOffice.display.replace(', India', '')} — within reach for teams based in Delhi NCR — and the machine is dispatched from Haldwani and Majkhali (Ranikhet). Share your work-order scope, site locations and programme, and RBE confirms availability, mobilisation and terms in writing. See <a href="/how-rental-works/">how rental works</a>.</p>
      </div>
    </div>
  </section>

  <NextSteps items={[
    { k: 'Project types', t: 'What the work looks like', d: 'Roads, slopes, plots, bridges and utilities.', href: '/project-solutions/' },
    { k: 'Machine', t: 'Is a backhoe loader enough?', d: 'Capabilities, limits and when to choose an excavator.', href: '/backhoe-loader-rental/#when-not' },
    { k: 'Support', t: 'What if it breaks down?', d: 'How support is agreed before work starts.', href: '/why-rbe/#support' },
  ]} />
  <QuoteBand heading="Send the site location. We’ll plan how the machine gets there." />
</Base>


<style>
  .mapgrid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: end; }
  .plist .mono { margin-left: 8px; font-size: .7rem; color: var(--on-dark-2); }
  .klabels { position: absolute; inset: 0; pointer-events: none; overflow: hidden; display: none; }
  :global(.stg.is-live) .klabels { display: block; }
  .kl { position: absolute; left: 0; top: 0; display: grid; gap: 1px; padding: 0 0 22px 0; border-left: 1px solid rgba(238,235,229,.6); opacity: 0; transition: opacity .35s var(--ease); white-space: nowrap; will-change: transform; transform-origin: 0 100%; }
  .kl { translate: 0 -100%; }
  .kl.is-on { opacity: .78; }
  .kl.is-hot { opacity: 1; }
  .kl b, .kl i { display: block; margin-left: -1px; padding: 0 9px; background: rgba(14,16,18,.62); backdrop-filter: blur(4px); }
  .kl b { padding-top: 4px; }
  .kl i { padding-bottom: 5px; }
  .kl b { font-family: var(--f-display); font-stretch: 110%; font-weight: 650; font-size: .95rem; color: var(--on-dark); text-shadow: 0 1px 8px rgba(0,0,0,.6); }
  .kl i { font-style: normal; font-family: var(--f-mono); font-size: .62rem; letter-spacing: .06em; color: var(--on-dark-2); text-shadow: 0 1px 6px rgba(0,0,0,.7); }
  .kl--base { border-left-color: var(--copper-hi); }
  .kl--base b { font-size: 1.15rem; }
  .kl--base i { color: var(--copper-hi); text-transform: uppercase; letter-spacing: .12em; }
  @media (max-width: 860px) { .kl b { font-size: .8rem; } .kl i { display: none; } .kl--base i { display: block; font-size: .55rem; } }
  .mapgrid h2 { font-size: clamp(1.9rem, 3.2vw, 2.8rem); }
  .plist { list-style: none; margin: 32px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .plist a { display: inline-block; padding: 6px 12px; border: 1px solid var(--line-d); text-decoration: none; font-size: .9rem; transition: border-color .2s, color .2s; }
  .plist a:hover, .plist a:focus-visible { border-color: var(--copper-hi); color: var(--copper-hi); }
  .elevhead { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 56px; align-items: end; margin-bottom: 40px; }
  .elevhead .eyebrow { grid-column: 1 / -1; margin: 0; }
  .elevhead h2 { font-size: clamp(1.7rem, 3vw, 2.5rem); }
  .belt__head { margin-bottom: 40px; }
  .belt__head h2 { font-size: clamp(2rem, 4vw, 3.4rem); }
  .belt__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 48px; }
  .belt h3 { font-size: 1.05rem; margin-bottom: 12px; }
  .belt__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-l); }
  .belt__list li { padding: 12px 0 12px 22px; border-bottom: 1px solid var(--line-l); position: relative; }
  .belt__list li::before { content: ''; position: absolute; left: 0; top: 22px; width: 10px; height: 2px; background: var(--steel); }
  .belt__list--w li::before { background: var(--copper); }
  .pcards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 16px; }
  .pcard { background: var(--paper); border: 1px solid var(--line-l); padding: 22px; display: flex; flex-direction: column; gap: 10px; scroll-margin-top: calc(var(--header-h) + 24px); }
  .stone .pcard { background: var(--paper); }
  .paper .pcard { background: var(--stone); border-color: transparent; }
  .pcard:target { outline: 2px solid var(--copper); }
  .pcard__base { margin: 0; font-size: .68rem !important; text-transform: uppercase; letter-spacing: .12em; color: var(--copper-lo); }
  .pcard__top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .pcard__top h3 { font-size: 1.35rem; margin: 0; }
  .pcard__top .mono { color: var(--copper-lo); font-size: .78rem; }
  .pcard__d { font-size: .72rem; color: var(--on-light-2); text-transform: uppercase; letter-spacing: .08em; margin: 0; }
  .pcard p { margin: 0; font-size: .95rem; }
  .pcard__links { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: .88rem !important; }
  .pcard__wa { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line-l); display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-size: .88rem; font-weight: 600; color: #1f7a4d; }
  .pcard__wa :global(svg) { width: 16px; }
  .pcard__wa:hover { color: #23905a; }
  .dep { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(40px, 6vw, 96px); }
  .dep h2 { font-size: clamp(1.9rem, 3.4vw, 3rem); }
  .factors { list-style: none; counter-reset: f; margin: 0; padding: 0; border-top: 1px solid var(--line-d); }
  .factors li { counter-increment: f; display: grid; grid-template-columns: 44px 1fr; gap: 4px 8px; padding: 18px 0; border-bottom: 1px solid var(--line-d); }
  .factors li::before { content: '0' counter(f); grid-row: span 2; font-family: var(--f-mono); font-size: .75rem; color: var(--copper-hi); padding-top: 4px; }
  .factors b { font-weight: 600; }
  .factors span { color: var(--on-dark-2); font-size: .95rem; }
  .out { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(32px, 6vw, 96px); }
  .out h2 { font-size: clamp(1.9rem, 3.4vw, 3rem); }
  .out li { margin-bottom: 14px; }
  @media (max-width: 960px) { .mapgrid, .elevhead, .belt__grid, .dep, .out { grid-template-columns: 1fr; } }
</style>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import QuoteBand from '../components/QuoteBand.astro';
import NextSteps from '../components/NextSteps.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
import { places } from '../data/geo';
import { qa } from '../data/faq';
import { breadcrumbs } from '../data/schema';
import Evidence from '../components/Evidence.astro';
import { caseFor } from '../data/cases';
import { photos, type Photo } from '../data/media';
// One real photograph per case, each used nowhere else on the site.
const casePhoto: Record<string, Photo> = { 'ranikhet-majkhali': photos.resortSnow, padampuri: photos.padStabilisers };
import { wa } from '../data/site';

const crumbs = [{ name: 'Project Solutions', href: '/project-solutions/' }];
const title = 'Backhoe Loaders for Road, Hill-Cutting & Site Work | RBE';
const description =
  'Road widening, hill cutting, resort plots, trenching and bridge works: the tasks a backhoe loader handles on Kumaon sites, and where it falls short.';
const stillAlt = [
  '3D illustration of a backhoe loader cutting a roadside drain along a widened hill road, with traffic cones and a tipper truck on the road.',
  '3D illustration of a backhoe loader on a bench cut into a hillside, pulling down the cut face during hill-cutting work while spoil builds at the toe.',
  '3D illustration of a backhoe loader back-filling soil behind a retaining wall on a building site, with concrete columns on the terrace above.',
  '3D illustration of a backhoe loader digging a bridge abutment pit on a riverbank beside gabion walls.',
  '3D illustration of a backhoe loader digging a utility pipeline trench along a town road between barricades, with pipes laid out on the verge.',
  '3D illustration of a backhoe loader levelling ground on an industrial plot while a steel portal-frame shed is erected.',
];
const placeName = (slug: string) => places.find((p) => p.slug === slug)?.name ?? slug;
---
<Base title={title} description={description} schema={[breadcrumbs(crumbs)]}>
  <PageHero crumbs={crumbs} eyebrow="Project solutions">
    <h1>Built around the project, <span class="serif">not the machine.</span></h1>
    <p class="lead">Six kinds of project RBE supports across Kumaon. For each: the tasks a backhoe loader takes on, what the terrain changes, and where you need something bigger. Every rental comes with an operator and runs for 15 days or more.</p>
  </PageHero>

  <div class="ps paper" data-stage="projects" data-mode="track" data-mid-mobile="0.72">
    <div class="wrap ps__grid">
      <aside class="ps__stage">
        <div class="ps__view">
          <img class="ps__poster" src="/scenes/projects-0.jpg" alt="" width="1600" height="1000" loading="lazy" decoding="async" aria-hidden="true" />
          <canvas class="ps__canvas" data-stage-canvas aria-hidden="true"></canvas>
          <nav class="ps__nav" aria-label="Project types">
            <ol>
              {projects.map((p, i) => <li><a href={`#${p.id}`} data-spy={p.id}><span class="mono">{String(i + 1).padStart(2, '0')}</span><span class="ps__t">{p.title}</span></a></li>)}
            </ol>
          </nav>
          <span class="ps__bar" aria-hidden="true"><i data-stage-bar></i></span>
        </div>
      </aside>

      <div class="ps__body">
        {projects.map((p, i) => (
          <article class="pj" id={p.id} aria-labelledby={`${p.id}-h`} data-track>
            <header class="pj__head">
              <span class="mono pj__n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2 id={`${p.id}-h`}>{p.title}</h2>
                <p class="pj__who mono">{p.who}</p>
              </div>
            </header>
            <p class="pj__short">{p.short}</p>
            <figure class="pj__fig"><img src={`/scenes/projects-${i}.jpg`} alt={stillAlt[i]} width="1600" height="1000" loading="lazy" decoding="async" /></figure>
            <div class="pj__cols">
              <div>
                <h3>Typical backhoe loader tasks</h3>
                <ul class="pj__tasks">{p.tasks.map((t) => <li>{t}</li>)}</ul>
              </div>
              <div>
                <h3>Site realities in Kumaon</h3>
                <p class="muted">{p.realities}</p>
                <h3 class="pj__lim">Where it stops</h3>
                <p class="muted">{p.limits}</p>
              </div>
            </div>
            {(() => { const c = caseFor(p.id); if (!c) return null; return (
              <section class="pjc" aria-label={`Real project: ${c.name}`}>
                <div class="pjc__txt">
                  <p class="mono pjc__k">On a real site · {c.district} district</p>
                  <h3>{c.name} — {c.work.toLowerCase()}</h3>
                  <p class="muted">{c.why}</p>
                  <p class="pjc__s"><b>RBE supplied:</b> {c.supplied}. <b>Work:</b> {c.scope.join(', ').toLowerCase()}.</p>
                </div>
                <div class="pjc__m"><Evidence photo={casePhoto[c.id]} ratio="4 / 5" short sizes="(max-width: 960px) 70vw, 18vw" /></div>
              </section>
            ); })()}
            <div class="pj__foot">
              <div class="pj__where">
                <span class="mono">Common around</span>
                {p.where.map((s) => <a href={`/kumaon-service-area/#${s}`}>{placeName(s)}</a>)}
              </div>
              <div class="pj__faq">
                <span class="mono">Related questions</span>
                <ul>{p.faq.map((id) => <li><a class="inline" href={`/knowledge/#${id}`}>{qa(id).q}</a></li>)}</ul>
              </div>
              <a class="btn btn--wa pj__cta" href={wa(`Hello RBE Capital Equip., I need a backhoe loader with operator for ${p.title.toLowerCase()} work.\nSite location:\nStart date:\nDuration (15 days minimum):`)} rel="noopener"><Icon name="wa" />Discuss this work on WhatsApp</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <NextSteps items={[
    { k: 'Machine', t: 'The backhoe loader in detail', d: 'Capabilities, typical specification and rental terms.', href: '/backhoe-loader-rental/' },
    { k: 'Process', t: 'From enquiry to machine on site', d: 'The six steps and what we need from you.', href: '/how-rental-works/' },
    { k: 'Geography', t: 'Sites across Kumaon', d: 'Plains, mid-hills and inner hills — what changes.', href: '/kumaon-service-area/' },
  ]} />
  <QuoteBand heading="Tell us the scope. We’ll tell you where a backhoe loader fits." />
</Base>

<script>
  import { initStages } from '../scripts/stage/runtime';
  initStages();
  // Highlight the current project type in the side index.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-spy]');
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    links.forEach((l) => l.toggleAttribute('aria-current', l.dataset.spy === e.target.id));
  }), { rootMargin: '-40% 0px -55% 0px' });
  document.querySelectorAll('.pj').forEach((el) => io.observe(el));
</script>

<style>
  .ps { padding-block: clamp(48px, 7vw, 104px); }
  .ps__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); grid-template-areas: 'body stage'; gap: clamp(32px, 5vw, 80px); align-items: start; }
  .ps__body { grid-area: body; }
  .ps__stage { grid-area: stage; display: none; }
  .pj { padding-bottom: clamp(56px, 7vw, 96px); margin-bottom: clamp(56px, 7vw, 96px); border-bottom: 1px solid var(--line-l); scroll-margin-top: calc(var(--header-h) + 24px); }
  .pj:last-child { border-bottom: 0; margin-bottom: 0; }
  .pj__head { display: grid; grid-template-columns: 56px 1fr; gap: 8px; align-items: start; }
  .pj__n { color: var(--copper); padding-top: 12px; }
  .pj h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); }
  .pj__who { margin-top: 12px; color: var(--on-light-2); font-size: .78rem; letter-spacing: .04em; }
  .pj__short { font-size: var(--t-lead); line-height: 1.5; margin: 24px 0 0; max-width: 46ch; }
  .pj__fig { margin: 32px 0; aspect-ratio: 16 / 10; background: var(--ink-3); overflow: hidden; }
  .pj__fig img { width: 100%; height: 100%; object-fit: cover; }
  .pj__cols { display: grid; grid-template-columns: 1fr; gap: 28px; margin-top: 32px; }
  .pj h3 { font-size: 1.05rem; margin-bottom: 14px; }
  .pj__lim { margin-top: 28px; }
  .pj__tasks { list-style: none; margin: 0; padding: 0; counter-reset: t; }
  .pj__tasks li { counter-increment: t; display: grid; grid-template-columns: 32px 1fr; padding: 10px 0; border-bottom: 1px dashed var(--line-l); }
  .pj__tasks li::before { content: counter(t, decimal-leading-zero); font-family: var(--f-mono); font-size: .72rem; color: var(--copper-lo); padding-top: 4px; }
  .pjc { margin-top: 40px; padding: 24px; background: var(--stone); display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 24px; align-items: end; }
  .pjc__k { font-size: .7rem; text-transform: uppercase; letter-spacing: .14em; color: var(--copper-lo); margin: 0 0 8px; }
  .pjc h3 { font-size: 1.25rem; margin-bottom: 10px; }
  .pjc p.muted { margin: 0; }
  .pjc__s { margin: 12px 0 0; font-size: .92rem; }
  .pj__foot { margin-top: 40px; display: grid; gap: 24px; }
  .pj__foot .mono { display: block; font-size: .7rem; text-transform: uppercase; letter-spacing: .12em; color: var(--on-light-2); margin-bottom: 10px; }
  .pj__where { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .pj__where .mono { flex-basis: 100%; }
  .pj__where a { padding: 6px 12px; border: 1px solid var(--line-l); text-decoration: none; font-size: .9rem; transition: border-color .2s, background .2s; }
  .pj__where a:hover { border-color: var(--copper); background: var(--stone); }
  .pj__faq ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .pj__cta { justify-self: start; }

  /* live: a sticky cinematic viewport beside the reading column */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ps:not(.is-static) .ps__stage { display: block; position: sticky; top: calc(var(--header-h) + 16px); height: calc(100vh - var(--header-h) - 32px); height: calc(100svh - var(--header-h) - 32px); }
    :global(.js) .ps:not(.is-static) .pj__fig { display: none; }
  }
  .ps__view { position: relative; width: 100%; height: 100%; background: var(--ink); overflow: hidden; }
  .ps__poster, .ps__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ps__poster { object-fit: cover; transition: opacity 1s var(--ease); }
  .ps__canvas { opacity: 0; transition: opacity 1.1s var(--ease); }
  :global(.ps.is-live) .ps__canvas { opacity: 1; }
  :global(.ps.is-live) .ps__poster { opacity: 0; }
  .ps__view::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(0deg, rgba(14,16,18,.82) 0%, rgba(14,16,18,0) 38%); }
  .ps__nav { position: absolute; left: 20px; right: 20px; bottom: 22px; z-index: 1; color: var(--on-dark); }
  .ps__nav ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }
  .ps__nav a { display: grid; gap: 6px; padding: 10px 0 0; border-top: 2px solid rgba(238,235,229,.25); text-decoration: none; font-size: .74rem; line-height: 1.25; color: var(--on-dark-2); transition: color .25s, border-color .25s; }
  .ps__nav a .mono { font-size: .66rem; color: var(--copper-hi); }
  .ps__nav a:hover, .ps__nav a[aria-current] { color: var(--on-dark); border-color: var(--copper); }
  .ps__bar { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: rgba(238,235,229,.1); z-index: 1; }
  .ps__bar i { position: absolute; inset: 0; background: var(--copper); transform-origin: left; transform: scaleX(0); }
  :global(.capture) .ps__view::after, :global(.capture) .ps__nav, :global(.capture) .ps__bar { display: none; }
  :global(.capture) .ps__stage { position: fixed !important; inset: 0 !important; height: 100vh !important; z-index: 50; display: block !important; }

  @media (max-width: 960px) {
    .ps__grid { grid-template-columns: 1fr; grid-template-areas: 'stage' 'body'; gap: 0; }
    .pj__head { grid-template-columns: 44px 1fr; }
    .pj__fig { margin-inline: calc(var(--gutter) * -1); }
    .pjc { padding: 20px; margin-inline: calc(var(--gutter) * -1); grid-template-columns: 1fr; }
    .pjc__m { max-width: 320px; }
  }
  @media (max-width: 960px) and (prefers-reduced-motion: no-preference) {
    :global(.js) .ps:not(.is-static) { padding-top: 0; }
    :global(.js) .ps:not(.is-static) .ps__stage { top: var(--header-h); height: 40vh; height: 40svh; z-index: 3; margin: 0 calc(var(--gutter) * -1) 28px; }
    .ps__nav { left: 14px; right: 14px; bottom: 12px; }
    .ps__t { display: none; }
    .ps__nav a { padding-top: 6px; }
  }
</style>

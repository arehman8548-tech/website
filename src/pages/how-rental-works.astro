---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import QuoteBand from '../components/QuoteBand.astro';
import NextSteps from '../components/NextSteps.astro';
import Icon from '../components/Icon.astro';
import ScrollStage, { type Chapter } from '../components/ScrollStage.astro';
import { breadcrumbs } from '../data/schema';
import { wa, site, mailtoWith } from '../data/site';
import { qa } from '../data/faq';

const crumbs = [{ name: 'How Rental Works', href: '/how-rental-works/' }];
const title = 'How Backhoe Loader Rental Works | RBE Capital Equip.';
const description =
  'Six steps from enquiry to a backhoe loader working on your Kumaon site, and the five details to send for a fast rental quote.';

const steps = [
  { t: 'Requirement', who: 'You', d: 'Tell us the site, the type of work, your start date and how long you need the machine. A WhatsApp message or email is enough to begin.', out: 'We reply with availability for your dates.' },
  { t: 'Site information', who: 'You + RBE', d: 'Share a map pin and the access route: road width, sharp bends, last-mile surface and where the machine will work and park. Photos help for hill sites.', out: 'We know how the machine will reach and work on the site.' },
  { t: 'Machine & terms', who: 'RBE', d: 'The quote sets out the machine, rental period, working hours, operator arrangement, diesel, mobilisation, idle-time and breakdown terms.', out: 'A quote you can review and approve.' },
  { t: 'Mobilisation', who: 'RBE', d: 'The machine moves out from Haldwani. Route, travel method (own wheels or trailer) and arrival date are fixed with season and road conditions in mind.', out: 'An agreed arrival date.' },
  { t: 'Deployment', who: 'RBE + your site team', d: 'The machine arrives and starts work. Your site contact and our operator agree the daily plan; working hours are recorded and signed off.', out: 'Work underway, hours on record.' },
  { t: 'Support & close-out', who: 'RBE + you', d: 'Servicing and breakdowns handled as set out in the terms, then an extension or return at the end of the rental.', out: 'Extension or return on the agreed terms.' },
];
const out = (who: string, o: string) => `<p class="stg-meta"><span>${who}</span> → ${o}</p>`;
const chapters: Chapter[] = [
  { span: 1, k: 'Requirement', h: 'Your site, your work, your dates.', html: `<p>${steps[0].d}</p>${out(steps[0].who, steps[0].out)}`, still: '/scenes/journey-0.jpg', alt: 'A levelled hillside plot at the top of a winding road, marked out with pegs and string lines and a site pin.' },
  { span: 1.1, k: 'Site information', h: 'How the machine reaches and works on your site.', html: `<p>${steps[1].d}</p>${out(steps[1].who, steps[1].out)}`, still: '/scenes/journey-1.jpg', alt: 'An aerial view down the switchback access road, traced from the plot to the foot of the hill.' },
  { span: 0.8, k: 'Machine & terms', h: 'The machine and the terms, in the quote.', html: `<p>${steps[2].d}</p>${out(steps[2].who, steps[2].out)}`, still: '/scenes/journey-2.jpg', alt: 'The backhoe loader at the foot of the hill road, ready to move.' },
  { span: 1.65, k: 'Mobilisation', h: 'Out from Haldwani, on a planned route.', html: `<p>${steps[3].d}</p>${out(steps[3].who, steps[3].out)}`, still: '/scenes/journey-3.jpg', alt: 'The backhoe loader climbing a hairpin bend on the hill road.' },
  { span: 0.55, k: 'Arrival', h: 'Into the plot. Stabilisers down.', p: 'The machine arrives on the agreed date and sets up where the site plan said it would work and park.', still: '/scenes/journey-4.jpg', alt: 'The backhoe loader on the plot with its stabilisers lowered.' },
  { span: 1.0, k: 'Work begins', h: 'Daily plan agreed, hours on record.', html: `<p>${steps[4].d}</p>${out(steps[4].who, steps[4].out)}`, still: '/scenes/journey-5.jpg', alt: 'The backhoe digging a foundation trench along the setting-out lines, spoil beside it.' },
  { span: 0.9, k: 'Support', h: 'Through the rental, to extension or return.', html: `<p>${steps[5].d}</p>${out(steps[5].who, steps[5].out)}`, cta: true, still: '/scenes/journey-6.jpg', alt: 'A wide view of the hill road and the working site, with the route back down traced.' },
];
const quoteInfo = qa('quote-info');
const quick = qa('how-quickly');
---
<Base title={title} description={description} schema={[breadcrumbs(crumbs)]}>
  <PageHero crumbs={crumbs} eyebrow="Process">
    <h1>From your first message to a <span class="serif">working machine.</span></h1>
    <p class="lead">Six steps, each with a clear outcome. Nothing reaches your site until availability, access and terms are settled.</p>
  </PageHero>

  <ScrollStage
    scene="journey"
    id="steps"
    label="The journey of one rental, from the first message to a working machine on a hill site"
    chapters={chapters}
    len={105}
    hud={[
      { k: 'travel', label: 'Road travelled', v: '0 m' },
      { k: 'climb', label: 'Height gained', v: '0 m' },
      { k: 'terms', label: 'Terms', v: 'Pending' },
      { k: 'hours', label: 'Hour meter', v: '—' },
    ]}
    caption="Illustrative hill site. Distances and heights read from the scene."
    ctaWa={wa('Site location:\nType of work:\nStart date:\nDuration:\nWorking hours per day:')}
  >
    <div class="jlabels" slot="overlay" aria-hidden="true">
      <span class="jl" data-label="work">Working &amp; parking area</span>
      <span class="jl" data-label="last">Last-mile surface</span>
      <span class="jl" data-label="bends">Sharp bends</span>
      <span class="jl" data-label="width">Road width</span>
      <span class="jl" data-label="route">Access route</span>
    </div>
  </ScrollStage>

  <section class="section dark" id="fast-quote" aria-labelledby="h-fast">
    <div class="wrap fast">
      <div>
        <p class="eyebrow"><span class="idx">→</span>For a fast quote</p>
        <h2 id="h-fast">Send these five things. <span class="serif">That’s all.</span></h2>
        <p class="muted" style="margin-top:20px">{quoteInfo.a}</p>
        <div class="btn-row" style="margin-top:32px">
          <a class="btn" href="/contact/">Use the enquiry form <Icon name="arrow" /></a>
          <a class="btn btn--wa" href={wa('Hello RBE Capital Equip., details for a backhoe loader quote:\nSite location:\nType of work:\nStart date:\nDuration:\nWorking hours per day:')} rel="noopener"><Icon name="wa" />WhatsApp the details</a>
        </div>
      </div>
      <ol class="five">
        <li><b>Site location</b><span>Map pin, village / town and district</span></li>
        <li><b>Type of work</b><span>Road, drains, foundations, cutting, trenching…</span></li>
        <li><b>Start date</b><span>When the machine must be working</span></li>
        <li><b>Duration</b><span>Days, months, or the project phase</span></li>
        <li><b>Working hours</b><span>Per day, and single or double shift</span></li>
      </ol>
    </div>
  </section>

  <section class="section--tight stone" aria-labelledby="h-time">
    <div class="wrap time">
      <div>
        <p class="eyebrow"><span class="idx">→</span>Timing</p>
        <h2 id="h-time">{quick.q}</h2>
      </div>
      <div class="prose">
        <p class="lead" style="max-width:none" set:html={quick.html ?? quick.a} />
        <p class="muted">Fastest route: WhatsApp <a href={wa()} rel="noopener">{site.whatsappDisplay}</a> · or email <a href={mailtoWith('Backhoe loader rental enquiry')}>{site.salesEmail}</a></p>
      </div>
    </div>
  </section>

  <NextSteps items={[
    { k: 'Contact', t: 'Start step one', d: 'Send your requirement — it takes two minutes.', href: '/contact/' },
    { k: 'Deployment', t: 'Mobilisation across Kumaon', d: 'What decides how fast the machine arrives.', href: '/kumaon-service-area/#deployment' },
    { k: 'Support', t: 'How breakdowns are handled', d: 'The support plan agreed before work starts.', href: '/why-rbe/#support' },
  ]} />
  <QuoteBand />
</Base>

<style>
  .jlabels { position: absolute; inset: 0; pointer-events: none; overflow: hidden; display: none; }
  :global(.stg.is-live) .jlabels { display: block; }
  .jl { position: absolute; left: 0; top: 0; translate: -50% -100%; padding: 6px 10px; margin-top: -10px; background: rgba(14,16,18,.7); backdrop-filter: blur(4px); border-bottom: 2px solid var(--copper-hi); font-family: var(--f-mono); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--on-dark); white-space: nowrap; opacity: 0; transition: opacity .4s var(--ease); }
  .jl.is-on { opacity: 1; }
  :global(.stg-meta) { margin-top: 14px !important; font-family: var(--f-mono); font-size: .74rem; letter-spacing: .04em; color: var(--on-dark-2); }
  :global(.stg-meta span) { color: var(--copper-hi); text-transform: uppercase; letter-spacing: .1em; }
  .fast { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .fast h2, .time h2 { font-size: clamp(1.9rem, 3.4vw, 3rem); }
  .five { list-style: none; counter-reset: v; margin: 0; padding: 0; border-top: 1px solid var(--line-d); }
  .five li { counter-increment: v; display: grid; grid-template-columns: 44px 1fr; gap: 2px 8px; padding: 18px 0; border-bottom: 1px solid var(--line-d); }
  .five li::before { content: counter(v); grid-row: span 2; width: 28px; height: 28px; border: 1px solid var(--copper-hi); color: var(--copper-hi); display: grid; place-items: center; font-family: var(--f-mono); font-size: .8rem; }
  .five b { font-weight: 600; font-size: 1.05rem; }
  .five span { color: var(--on-dark-2); font-size: .92rem; }
  .time { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(32px, 6vw, 96px); }
  @media (max-width: 960px) {
      .fast, .time { grid-template-columns: 1fr; }
  }
</style>

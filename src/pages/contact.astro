---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbs } from '../data/schema';
import { site, tel, tel2, wa, mailto, mailtoContact } from '../data/site';
import { projects } from '../data/projects';

const crumbs = [{ name: 'Project Enquiry', href: '/contact/' }];
const title = 'Check JCB Backhoe Availability for Your Site | RBE';
const description =
  `Send your site location, work type and start date. Sales ${site.phoneDisplay} · Site Coordination ${site.phone2Display} · WhatsApp, 8 AM–8 PM.`;
---
<Base title={title} description={description} pageType="ContactPage" schema={[breadcrumbs(crumbs)]} intent="enquiry">
  <section class="ct dark">
    <div class="ct__bg" aria-hidden="true"><img src="/scenes/contact.jpg" alt="" width="1600" height="1000" decoding="async" fetchpriority="low" /></div>
    <div class="wrap ct__grid">
      <div class="ct__side">
        <Breadcrumbs items={crumbs} />
        <p class="eyebrow"><span class="idx">RBE</span>Project enquiry</p>
        <h1>Book a backhoe loader <span class="serif">for your dates.</span></h1>
        <p class="lead muted">Two minutes on a phone. RBE replies with availability, how the machine reaches your site and the terms — operator included, 15 days minimum.</p>

        <div class="ct__direct">
          <a class="ct__ch" href={tel}>
            <Icon name="phone" />
            <span><b>Call {site.phoneLabel}</b><span class="mono">{site.phoneDisplay} · quotes, availability, rental terms</span></span>
          </a>
          <a class="ct__ch" href={tel2}>
            <Icon name="phone" />
            <span><b>Call {site.phone2Label}</b><span class="mono">{site.phone2Display} · machine on site, mobilisation, emergency clearance</span></span>
          </a>
          <a class="ct__ch ct__ch--wa" href={wa()} rel="noopener">
            <Icon name="wa" />
            <span><b>WhatsApp</b><span class="mono">{site.whatsappDisplay} · map pin or site photos</span></span>
          </a>
          <a class="ct__ch" href={mailto}>
            <Icon name="mail" />
            <span><b>Sales enquiries</b><span class="mono">{site.email}</span></span>
          </a>
          <a class="ct__ch" href={mailtoContact}>
            <Icon name="mail" />
            <span><b>General contact</b><span class="mono">{site.contactEmail}</span></span>
          </a>
          <p class="mono ct__hours"><Icon name="clock" />Enquiry hours · {site.hours}</p>
          <dl class="ct__facts mono">
            <div><dt>Head office</dt><dd>{site.headOffice.display}</dd></div>
            <div><dt>Machine dispatched from</dt><dd>Haldwani · Majkhali (Ranikhet)</dd></div>
            <div><dt>Terms</dt><dd>Operator included · 15-day minimum · GST invoice on request</dd></div>
          </dl>
        </div>

        <div class="ct__next">
          <h2>What happens next</h2>
          <ol>
            <li>Your enquiry is emailed to RBE’s sales team with a reference number (shown on screen when it is received).</li>
            <li>RBE confirms whether the machine is available for your start date.</li>
            <li>RBE checks the site location and access, and asks for anything missing.</li>
            <li>You receive the terms in writing — period, hours, operator, diesel, mobilisation, idle-time and breakdown handling.</li>
            <li>One named contact stays with your project from then on.</li>
          </ol>
          <a class="inline" href="/how-rental-works/">The full rental process →</a>
          <p class="ct__urgent">Road blocked or a slip on site? <a class="inline" href={tel2}>Call {site.phone2Label} on {site.phone2Display}</a> — see <a class="inline" href="/emergency-earthwork/">emergency earthwork &amp; road clearance</a>.</p>
        </div>
      </div>

      <div class="ct__formwrap">
        <form class="fm" data-form action={site.formEndpoint} method="post" data-endpoint={site.formEndpoint} data-wa={site.whatsappE164} data-email={site.email} novalidate>
          <div class="fm__head">
            <h2>Project enquiry</h2>
            <p class="mono">Fields marked * are required</p>
          </div>
          <div class="fm__ready" data-ready>
            <ol class="fm__seg" aria-hidden="true">
              <li data-seg="f-name"></li><li data-seg="f-phone"></li><li data-seg="f-loc"></li><li data-seg="f-type" class="opt"></li><li data-seg="f-start" class="opt"></li><li data-seg="f-dur" class="opt"></li>
            </ol>
            <p class="mono" data-ready-text>Name, phone and site location are all we need to start.</p>
          </div>
          <div class="fm__grid">
            <div class="f">
              <label for="f-name">Name *</label>
              <input id="f-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="f">
              <label for="f-company">Company</label>
              <input id="f-company" name="company" type="text" autocomplete="organization" />
            </div>
            <div class="f">
              <label for="f-phone">Phone / WhatsApp *</label>
              <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required pattern="^[+]?[0-9 \-]{10,15}$" aria-describedby="f-phone-h" />
              <p class="f__h" id="f-phone-h">10-digit mobile number</p>
            </div>
            <div class="f">
              <label for="f-email">Email</label>
              <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" aria-describedby="f-email-h" />
              <p class="f__h" id="f-email-h">Optional — for the written quote</p>
            </div>
            <div class="f">
              <label for="f-loc">Project location *</label>
              <input id="f-loc" name="location" type="text" required placeholder="e.g. near Bhowali, Nainital district" aria-describedby="f-loc-h" />
              <p class="f__h" id="f-loc-h">Town, village or a map link</p>
            </div>
            <div class="f">
              <label for="f-type">Project type</label>
              <select id="f-type" name="type">
                <option value="">Select…</option>
                {projects.map((p) => <option value={p.title}>{p.title}</option>)}
                <option value="Emergency earthwork & road clearance">Emergency earthwork &amp; road clearance</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="f">
              <label for="f-eq">Required equipment</label>
              <select id="f-eq" name="equipment">
                <option>JCB backhoe loader</option>
                <option>JCB backhoe loader with rock breaker</option>
                <option>Not sure — please advise</option>
              </select>
            </div>
            <div class="f">
              <label for="f-dur">Rental duration</label>
              <select id="f-dur" name="duration">
                <option value="">Select…</option>
                <option>15 days – 1 month</option>
                <option>1–3 months</option>
                <option>3–6 months</option>
                <option>6+ months / project duration</option>
                <option>Not sure yet</option>
              </select>
              <p class="f__h">Minimum rental is 15 days</p>
            </div>
            <div class="f">
              <label for="f-start">Expected start date</label>
              <input id="f-start" name="start" type="date" />
            </div>
            <div class="f">
              <label for="f-gst">GST invoice</label>
              <select id="f-gst" name="gst">
                <option value="">Select…</option>
                <option>GST invoice required</option>
                <option>Not required</option>
              </select>
            </div>
            <div class="f">
              <label for="f-role">Your role</label>
              <select id="f-role" name="role">
                <option value="">Select…</option>
                <option>Main contractor</option>
                <option>Subcontractor</option>
                <option>Developer (hotel, resort, industrial, commercial, real estate)</option>
                <option>Project manager / site engineer</option>
                <option>Procurement</option>
                <option>Other</option>
              </select>
            </div>
            <div class="f f--full">
              <label for="f-det">Additional details</label>
              <textarea id="f-det" name="details" rows="4" placeholder="Scope of work, working hours per day, access road (width, bends, last stretch), rock expected?"></textarea>
            </div>
          </div>
          <div class="fm__hp" aria-hidden="true"><label for="f-web">Leave this empty</label><input id="f-web" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
          <div class="fm__foot">
            <button class="btn" type="submit" data-submit>
              <span data-submit-label>Send enquiry</span> <Icon name="arrow" />
            </button>
            <p class="mono fm__alt">or <a href={mailto} data-mail>send by email</a></p>
          </div>
          <p class="mono fm__alt fm__hrs">Enquiry hours: {site.hours}. You can send the form at any time. Your details are used only to reply to this enquiry.</p>
          <p class="fm__status" role="status" aria-live="polite" data-status></p>
        </form>

        <div class="fm fm__result" data-ok hidden tabindex="-1" aria-labelledby="ok-h">
          <p class="mono fm__tag">Sent to RBE sales</p>
          <h2 id="ok-h">Enquiry received</h2>
          <p class="fm__ref">Reference: <b class="mono" data-ref></b></p>
          <p>Our team will contact you using the details provided.</p>
          <div class="btn-row">
            <a class="btn btn--wa" href={wa()} rel="noopener" data-wa-follow><Icon name="wa" />Also send on WhatsApp</a>
          </div>
          <p class="mono fm__alt fm__lines">{site.phoneLabel} <a href={tel}>{site.phoneDisplay}</a> · {site.phone2Label} <a href={tel2}>{site.phone2Display}</a></p>
          <p class="fm__more">While you wait: <a class="inline" href="/how-rental-works/">what happens next</a> · <a class="inline" href="/jcb-rental-rates/">how the rental is priced</a></p>
        </div>

        <div class="fm fm__result fm__result--err" data-err hidden tabindex="-1" aria-labelledby="err-h">
          <p class="mono fm__tag">Not sent</p>
          <h2 id="err-h">Your enquiry could not be submitted.</h2>
          <p>Nothing was lost — your details are still in the form. Please try again, or reach RBE directly:</p>
          <div class="btn-row">
            <button class="btn" type="button" data-retry>Try again <Icon name="arrow" /></button>
            <a class="btn btn--wa" href={wa()} rel="noopener" data-wa-fallback><Icon name="wa" />Send on WhatsApp</a>
          </div>
          <p class="mono fm__alt fm__lines"><a href={tel}>Call {site.phoneLabel} · {site.phoneDisplay}</a><br /><a href={tel2}>Call {site.phone2Label} · {site.phone2Display}</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Enquiry readiness: required details first, then the ones that make a quote faster.
  {
    const ready = document.querySelector<HTMLElement>('[data-ready]');
    const text = ready?.querySelector<HTMLElement>('[data-ready-text]');
    const segs = [...(ready?.querySelectorAll<HTMLElement>('[data-seg]') ?? [])];
    const update = () => {
      let req = 0, opt = 0;
      for (const sg of segs) {
        const el = document.getElementById(sg.dataset.seg!) as HTMLInputElement | HTMLSelectElement | null;
        const ok = !!el && el.value.trim() !== '' && (!(el instanceof HTMLInputElement) || el.checkValidity());
        sg.classList.toggle('is-on', ok);
        if (ok) sg.classList.contains('opt') ? opt++ : req++;
      }
      if (!text) return;
      text.textContent = req < 3 ? `${req} of 3 required details` : opt < 3 ? `Ready to send — add type of work, start date or duration for a faster quote` : 'Ready to send — everything we need for a quote';
      ready!.classList.toggle('is-ready', req === 3);
    };
    document.querySelector('[data-form]')?.addEventListener('input', update);
    document.querySelector('[data-form]')?.addEventListener('change', update);
  }

  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const endpoint = form.dataset.endpoint ?? '';
  const okBox = document.querySelector<HTMLElement>('[data-ok]')!;
  const errBox = document.querySelector<HTMLElement>('[data-err]')!;
  const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const btnLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
  const track = (e: string, p: Record<string, string> = {}) => window.rbeTrack?.(e, { placement: 'contact_form', ...p });

  // Pre-select project type from ?type= (used by project, developer and emergency links)
  const t = new URLSearchParams(location.search).get('type');
  if (t) {
    const sel = form.querySelector<HTMLSelectElement>('#f-type')!;
    const opt = [...sel.options].find((o) => o.value && o.value.toLowerCase().startsWith(t.toLowerCase()));
    if (opt) sel.value = opt.value;
  }

  let started = false;
  form.addEventListener('input', () => { if (!started) { started = true; track('form_start'); } });

  const labels: Record<string, string> = { name: 'Name', company: 'Company', phone: 'Phone', email: 'Email', location: 'Project location', type: 'Project type', equipment: 'Equipment', duration: 'Duration', start: 'Start date', gst: 'GST invoice', role: 'Role', details: 'Details' };
  const summary = (fd: FormData, ref?: string) =>
    [`Backhoe loader enquiry — RBE Capital Equip.${ref ? ` (website reference ${ref})` : ''}`, ...[...fd.entries()].filter(([k, v]) => labels[k] && String(v).trim()).map(([k, v]) => `${labels[k]}: ${v}`)].join('\n');
  const waLink = (text: string) => `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(text)}`;

  const validate = () => {
    let ok = true;
    form.querySelectorAll<HTMLInputElement>('input[required], input[pattern], input[type=email]').forEach((el) => {
      const valid = el.checkValidity();
      el.setAttribute('aria-invalid', String(!valid));
      if (!valid && ok) { el.focus(); ok = false; }
    });
    if (!ok) { status.textContent = 'Please fill in your name, a valid phone number and the project location.'; track('form_validation_error'); }
    return ok;
  };

  form.querySelector<HTMLAnchorElement>('[data-mail]')!.addEventListener('click', (e) => {
    if (!validate()) { e.preventDefault(); return; }
    const body = summary(new FormData(form));
    (e.currentTarget as HTMLAnchorElement).href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Backhoe loader enquiry')}&body=${encodeURIComponent(body)}`;
    track('form_email_fallback');
  });

  const show = (box: HTMLElement) => { form.hidden = true; box.hidden = false; box.focus(); box.scrollIntoView({ block: 'start', behavior: 'smooth' }); };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = '';
    if (!validate()) return;
    const fd = new FormData(form);
    track('form_submit', { label: String(fd.get('type') || 'unspecified').slice(0, 80) });
    btn.disabled = true;
    btnLabel.textContent = 'Sending…';
    try {
      const payload: Record<string, string> = {};
      fd.forEach((v, k) => { payload[k] = String(v); });
      const attr = window.rbeAttribution?.() ?? {};
      for (const [k, v] of Object.entries(attr)) if (v) payload[k] = v;
      const r = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload) });
      const res = await r.json().catch(() => ({}));
      if (!r.ok || !res.ok) throw new Error(res.error === 'validation' ? 'validation' : `http_${r.status}`);
      const ref = String(res.ref || '');
      okBox.querySelector<HTMLElement>('[data-ref]')!.textContent = ref;
      okBox.querySelector<HTMLAnchorElement>('[data-wa-follow]')!.href = waLink(summary(fd, ref));
      track('form_success', { enquiry_ref: ref });
      show(okBox);
      form.reset();
    } catch (err) {
      const reason = err instanceof Error ? err.message : 'network';
      track('form_error', { reason: reason === 'Failed to fetch' ? 'network' : reason.slice(0, 40) });
      if (reason === 'validation') { status.textContent = 'Please check your name, phone number and project location, then try again.'; }
      else {
        errBox.querySelector<HTMLAnchorElement>('[data-wa-fallback]')!.href = waLink(summary(fd));
        show(errBox);
      }
    } finally {
      btn.disabled = false;
      btnLabel.textContent = 'Send enquiry';
    }
  });

  okBox.querySelector('[data-wa-follow]')!.addEventListener('click', () => track('form_whatsapp_followup'));
  errBox.querySelector('[data-wa-fallback]')!.addEventListener('click', () => track('form_whatsapp_fallback'));
  errBox.querySelector('[data-retry]')!.addEventListener('click', () => { errBox.hidden = true; form.hidden = false; btn.focus(); });
</script>

<style>
  .ct__bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .ct__bg img { width: 100%; height: 100%; object-fit: cover; opacity: .34; filter: saturate(.85); transform: scale(1.06); animation: ct-drift 60s var(--ease) infinite alternate; }
  .ct__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(14,16,18,.55) 0%, rgba(14,16,18,.82) 48%, rgba(14,16,18,.96) 70%), linear-gradient(0deg, var(--ink) 0%, rgba(14,16,18,0) 40%); }
  @keyframes ct-drift { from { transform: scale(1.06) translate3d(0, 0, 0); } to { transform: scale(1.12) translate3d(-2%, -1%, 0); } }
  @media (prefers-reduced-motion: reduce) { .ct__bg img { animation: none; } }
  .ct__grid { position: relative; }
  .fm__ready { margin: -12px 0 24px; }
  .fm__seg { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr) repeat(3, .6fr); gap: 4px; margin: 0 0 8px; padding: 0; }
  .fm__seg li { height: 3px; background: var(--line-l); transition: background .35s var(--ease); }
  .fm__seg li.is-on { background: var(--copper); }
  .fm__seg li.opt.is-on { background: var(--steel); }
  .fm__ready p { margin: 0; font-size: .72rem; color: var(--on-light-2); }
  .fm__ready.is-ready p { color: var(--copper-lo); }
  .ct { position: relative; overflow: hidden; padding-top: calc(var(--header-h) + clamp(40px, 6vw, 88px)); padding-bottom: clamp(64px, 8vw, 120px); min-height: 100vh; }
  .ct__grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .ct h1 { font-size: clamp(2.4rem, 5vw, 4.4rem); }
  .ct .lead { margin-top: 24px; }
  .ct__direct { margin-top: 40px; display: grid; gap: 10px; }
  .ct__ch { display: flex; align-items: center; gap: 16px; padding: 18px 20px; border: 1px solid var(--line-d); text-decoration: none; transition: border-color .2s, background .2s; }
  .ct__ch:hover { border-color: var(--copper-hi); background: rgba(238,235,229,.03); }
  .ct__ch :global(svg) { width: 22px; height: 22px; color: var(--copper-hi); flex: none; }
  .ct__ch--wa :global(svg) { color: #3fbf7f; }
  .ct__ch > span { display: grid; gap: 2px; }
  .ct__ch b { font-weight: 600; }
  .ct__ch .mono { font-size: .8rem; color: var(--on-dark-2); }
  .ct__facts { margin: 14px 0 0; display: grid; gap: 10px; font-size: .78rem; color: var(--on-dark-2); }
  .ct__facts dt { text-transform: uppercase; letter-spacing: .12em; font-size: .68rem; }
  .ct__facts dd { margin: 2px 0 0; color: var(--on-dark); }
  .ct__hours { display: flex; align-items: center; gap: 8px; color: var(--on-dark-2); font-size: .78rem; margin-top: 6px; }
  .ct__hours :global(svg) { width: 16px; }
  .ct__next { margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--line-d); }
  .ct__next h2 { font-size: 1.3rem; margin-bottom: 16px; }
  .ct__next ol { padding-left: 1.2em; margin: 0 0 16px; color: var(--on-dark-2); }
  .ct__next li { margin-bottom: 8px; }
  .ct__next li::marker { color: var(--copper-hi); font-family: var(--f-mono); }

  .ct__formwrap { position: sticky; top: calc(var(--header-h) + 24px); }
  .fm { background: var(--paper); color: var(--on-light); padding: clamp(24px, 3.5vw, 44px); }
  .fm__head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; padding-bottom: 20px; border-bottom: 1px solid var(--line-l); }
  .fm__head h2 { font-size: 1.6rem; }
  .fm__head .mono { font-size: .72rem; color: var(--on-light-2); }
  .fm__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 20px; }
  .f { display: grid; gap: 6px; }
  .f--full { grid-column: 1 / -1; }
  .f label { font-size: .85rem; font-weight: 600; }
  .f input, .f select, .f textarea { width: 100%; min-height: 50px; padding: 12px 14px; border: 1px solid var(--line-l); border-radius: var(--radius); background: #fff; font-size: 1rem; transition: border-color .2s, box-shadow .2s; }
  .f textarea { resize: vertical; min-height: 110px; }
  .f select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--on-light-2) 50%), linear-gradient(135deg, var(--on-light-2) 50%, transparent 50%); background-position: calc(100% - 20px) 22px, calc(100% - 15px) 22px; background-size: 5px 5px; background-repeat: no-repeat; padding-right: 36px; }
  .f input:focus, .f select:focus, .f textarea:focus { outline: none; border-color: var(--copper); box-shadow: 0 0 0 3px rgba(196,105,44,.18); }
  .f [aria-invalid='true'] { border-color: #b3261e; }
  .f__h { margin: 0; font-size: .78rem; color: var(--on-light-2); }
  .fm__foot { display: flex; align-items: center; flex-wrap: wrap; gap: 16px 24px; margin-top: 28px; }
  .fm__alt { font-size: .82rem; color: var(--on-light-2); }
  .fm__hrs { margin: 14px 0 0; }
  .fm__alt a { color: inherit; }
  .fm__status { margin: 16px 0 0; font-weight: 500; min-height: 1.5em; }
  .fm__hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .fm__result h2 { font-size: clamp(1.6rem, 2.6vw, 2.2rem); margin-bottom: 16px; }
  .fm__result p { margin-bottom: 14px; }
  .fm__result .btn-row { margin: 22px 0 18px; }
  .fm__result:focus { outline: none; }
  .fm__tag { margin: 0 0 10px !important; font-size: .72rem; text-transform: uppercase; letter-spacing: .14em; color: var(--copper-lo); }
  .fm__result--err .fm__tag { color: #b3261e; }
  .fm__ref { font-size: 1.05rem; }
  .fm__ref b { font-size: 1.05rem; color: var(--copper-lo); }
  .fm__lines a { color: inherit; }
  .fm__more { font-size: .92rem; color: var(--on-light-2); }
  .ct__urgent { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line-d); color: var(--on-dark-2); font-size: .95rem; }
  .fm { position: relative; }
  /* The form panels are light inside a dark section: keep their links dark. */
  .ct .fm a:not(.btn) { color: var(--on-light); }
  .ct .fm a.inline:hover { color: var(--copper-lo); }
  @media (max-width: 960px) {
    .ct__grid { grid-template-columns: 1fr; }
    .ct__formwrap { position: static; }
  }
  @media (max-width: 600px) {
    .fm { margin-inline: calc(var(--gutter) * -1); }
    .fm__grid { grid-template-columns: 1fr; }
    .fm__foot .btn { width: 100%; justify-content: center; }
  }
</style>

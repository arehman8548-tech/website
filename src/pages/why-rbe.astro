---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import QuoteBand from '../components/QuoteBand.astro';
import NextSteps from '../components/NextSteps.astro';
import Wordmark from '../components/Wordmark.astro';
import ScrollStage, { type Chapter } from '../components/ScrollStage.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbs } from '../data/schema';
import { qa } from '../data/faq';
import { site, mailto } from '../data/site';

const crumbs = [{ name: 'Why RBE', href: '/why-rbe/' }];
const title = 'Why RBE Capital Equip. — Rental for Project Teams';
const description =
  'RBE Capital Equip., an enterprise of Rotoblast Engineering, rents backhoe loaders to project teams in Kumaon from Haldwani. What to settle before work starts.';

const rows = [
  ['Availability', '“Should be free” on the phone.', 'Checked against your start date and duration before you commit.'],
  ['The machine', 'Whatever turns up.', 'Make, model and specification stated in the quote.'],
  ['Getting to site', 'Route worked out on the day.', 'Route, travel method and arrival date worked out with the quote.'],
  ['Breakdowns', 'You chase the owner.', 'Reporting, attendance and downtime terms settled at quote stage.'],
  ['Who you deal with', 'An individual owner.', 'An enterprise of Rotoblast Engineering, deploying from Haldwani.'],
  ['Machine fit', 'Whatever is available.', 'A straight view on whether a backhoe loader is right — or an excavator is.'],
];
const breakdown = qa('breakdown');

const chapters: Chapter[] = [
  { k: 'Requirement', h: 'It starts with your site and your dates.', p: 'Availability is checked against your start date and duration before you commit — not “should be free” on the phone.', still: '/scenes/yard-0.jpg', alt: 'Dawn over an equipment yard at Haldwani, with a light marking a project site on the hills to the north.' },
  { k: 'Planning', h: 'The machine, stated in the quote.', p: 'Make, model and specification are written into the quote, with the operator arrangement and what travels with it — so you know what is coming to your site.', still: '/scenes/yard-1.jpg', alt: 'A backhoe loader under floodlights on the hardstand in front of the workshop.' },
  { k: 'Mobilisation', h: 'Route and travel method worked out in advance.', p: 'On its own wheels for nearby sites, or on a low-bed trailer for longer moves into the hills. The route and arrival date are worked out with the quote, not on the day.', still: '/scenes/yard-2.jpg', alt: 'The backhoe loader driving up the ramps onto a low-bed trailer.' },
  { k: 'Deployment', h: 'Deployed from Haldwani, at the foot of the hills.', p: 'Haldwani is where the plains meet the Kumaon hills, so machines start every move at the gateway to the hill roads.', still: '/scenes/yard-3.jpg', alt: 'The low-bed carrying the backhoe loader along the road out of the yard towards the hills.' },
  { k: 'Project support', h: 'Downtime terms settled before work starts.', p: 'Who you contact, who attends, expected repair times and servicing — settled at quote stage, so nothing is renegotiated while your site waits.', cta: true, still: '/scenes/yard-4.jpg', alt: 'Aerial view of the road leading from the yard towards the hills and the project site.' },
];
---
<Base title={title} description={description} schema={[breadcrumbs(crumbs)]}>
  <PageHero crumbs={crumbs} eyebrow="Why RBE">
    <h1>An equipment partner, <span class="serif">not a machine on hire.</span></h1>
    <p class="lead">On a serious project, the rental is the easy part. What matters is whether the machine arrives when planned, keeps working, and whether someone responsible answers when it doesn’t.</p>
  </PageHero>

  <ScrollStage
    scene="yard"
    id="from-haldwani"
    label="From requirement to deployment: a backhoe loader leaves the Haldwani base for a hill site"
    chapters={chapters}
    tone="dusk"
    hud={[
      { k: 'avail', label: 'Availability', v: 'Checking' },
      { k: 'check', label: 'Machine', v: 'Pending' },
      { k: 'route', label: 'Route & transport', v: 'Pending' },
      { k: 'support', label: 'Support terms', v: 'Pending' },
    ]}
    caption="Illustrative scene of a deployment from Haldwani."
  />

  <section class="section paper" aria-labelledby="h-diff">
    <div class="wrap">
      <div class="dhead">
        <p class="eyebrow"><span class="idx">01</span>The difference</p>
        <h2 id="h-diff">The same machine. A very different rental.</h2>
      </div>
      <div class="cmp" role="table" aria-label="Comparison: a machine on hire versus an equipment partner">
        <div class="cmp__row cmp__row--h" role="row">
          <span role="columnheader"></span>
          <span role="columnheader">A machine on hire</span>
          <span role="columnheader">RBE Capital Equip.</span>
        </div>
        {rows.map(([k, a, b]) => (
          <div class="cmp__row rv" role="row">
            <span role="rowheader" class="mono">{k}</span>
            <span role="cell" class="cmp__a">{a}</span>
            <span role="cell" class="cmp__b">{b}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section dark" id="support" aria-labelledby="h-sup">
    <div class="wrap sup">
      <div>
        <p class="eyebrow"><span class="idx">02</span>Support</p>
        <h2 id="h-sup">Downtime terms are settled <span class="serif">before</span> the machine arrives.</h2>
        <div class="answer" style="margin-top:32px">
          <h3>{breakdown.q}</h3>
          <p class="muted">{breakdown.a}</p>
        </div>
      </div>
      <ol class="phase">
        <li><span class="mono">Before work</span><b>Settle the support terms</b><p>Who you contact, who attends, expected repair times, the servicing schedule and what happens if a repair runs long.</p></li>
        <li><span class="mono">Before dispatch</span><b>Confirm the machine</b><p>Make, model and specification, what travels with it, and the operator arrangement — as stated in the quote.</p></li>
        <li><span class="mono">On site</span><b>Servicing and supplies</b><p>When routine servicing happens and how it affects your hours; how diesel and consumables reach a remote site.</p></li>
        <li><span class="mono">If it stops</span><b>Follow the agreed terms</b><p>No renegotiating while your site waits — the steps were settled at the start.</p></li>
      </ol>
    </div>
  </section>

  <section class="section stone" id="rotoblast" aria-labelledby="h-roto">
    <div class="wrap roto">
      <div class="roto__mark"><Wordmark size="xl" href={null} tone="dark" /></div>
      <div>
        <p class="eyebrow"><span class="idx">03</span>The organisation</p>
        <h2 id="h-roto">An enterprise of Rotoblast Engineering.</h2>
        <div class="prose" style="margin-top:24px">
          <p>RBE Capital Equip. is an enterprise of Rotoblast Engineering. Its head office is in Sector 27C, Faridabad, Haryana, and its machines are deployed from Haldwani, Uttarakhand, to project sites across Kumaon.</p>
          <p>For a procurement team, that means contracting with an organisation — with a head office and a sales desk at <a href={mailto}>{site.salesEmail}</a> — rather than with an individual machine owner.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section paper" aria-labelledby="h-wont">
    <div class="wrap two">
      <div>
        <p class="eyebrow"><span class="idx">04</span>Straight dealing</p>
        <h2 id="h-wont">What to avoid in any rental.</h2>
        <ul class="xlist">
          <li>A start date nobody has checked against the access road.</li>
          <li>A backhoe loader sent to a job that needs an excavator.</li>
          <li>Vague idle-time, diesel or mobilisation terms.</li>
          <li>No agreed process for breakdowns.</li>
        </ul>
      </div>
      <div>
        <p class="eyebrow"><span class="idx">05</span>Working together</p>
        <h2>What we’ll ask of you.</h2>
        <ul class="xlist xlist--ok">
          <li>An accurate site location and honest access details.</li>
          <li>A safe, stable working area for the machine.</li>
          <li>A site contact for daily coordination and hours sign-off.</li>
          <li>Early notice if your schedule moves.</li>
        </ul>
      </div>
    </div>
  </section>

  <NextSteps items={[
    { k: 'Process', t: 'How a rental runs', d: 'Requirement to return, step by step.', href: '/how-rental-works/' },
    { k: 'Machine', t: 'What the backhoe loader can do', d: 'Capabilities and typical specification.', href: '/backhoe-loader-rental/' },
    { k: 'Contact', t: 'Request a rental quote', d: 'WhatsApp, email or send the project form.', href: '/contact/' },
  ]} />
  <QuoteBand heading="Discuss your project and the terms before anything moves." />
</Base>

<style>
  .dhead { margin-bottom: 48px; max-width: 900px; }
  .dhead h2, .sup h2, .roto h2, .two h2 { font-size: clamp(1.9rem, 3.6vw, 3.2rem); }
  .cmp { border-top: 1px solid var(--line-l); }
  .cmp__row { display: grid; grid-template-columns: 200px 1fr 1fr; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--line-l); align-items: baseline; }
  .cmp__row--h { font-family: var(--f-mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .12em; color: var(--on-light-2); padding: 14px 0; }
  .cmp__row--h span:last-child { color: var(--copper-lo); }
  .cmp__row .mono { font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; color: var(--on-light-2); }
  .cmp__a { color: var(--on-light-2); text-decoration: line-through; text-decoration-color: rgba(84,91,98,.4); }
  .cmp__b { font-weight: 500; font-size: 1.05rem; padding-left: 20px; border-left: 2px solid var(--copper); }
  .sup { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(40px, 6vw, 96px); }
  .phase { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-d); }
  .phase li { padding: 22px 0; display: grid; gap: 6px; border-bottom: 1px solid var(--line-d); }
  .phase .mono { font-size: .7rem; text-transform: uppercase; letter-spacing: .12em; color: var(--copper-hi); }
  .phase b { font-family: var(--f-display); font-stretch: 110%; font-size: 1.3rem; font-weight: 650; }
  .phase p { color: var(--on-dark-2); margin: 0; }
  .roto { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .roto__mark { padding: clamp(32px, 5vw, 72px); border: 1px solid var(--line-l); display: grid; place-items: center; background: var(--paper); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); }
  .xlist { list-style: none; margin: 28px 0 0; padding: 0; border-top: 1px solid var(--line-l); }
  .xlist li { padding: 16px 0 16px 34px; border-bottom: 1px solid var(--line-l); position: relative; font-size: 1.05rem; }
  .xlist li::before, .xlist li::after { content: ''; position: absolute; left: 4px; top: 27px; width: 14px; height: 2px; background: var(--on-light-2); transform: rotate(45deg); }
  .xlist li::after { transform: rotate(-45deg); }
  .xlist--ok li::before { width: 12px; height: 7px; background: none; border-left: 2px solid var(--copper); border-bottom: 2px solid var(--copper); transform: rotate(-45deg); top: 21px; }
  .xlist--ok li::after { display: none; }
  @media (max-width: 960px) {
    .sup, .roto, .two { grid-template-columns: 1fr; }
    .cmp__row { grid-template-columns: 1fr 1fr; }
    .cmp__row > :first-child { grid-column: 1 / -1; }
    .cmp__row--h > :first-child { display: none; }
    .roto__mark :global(.wm--xl) { --s: 1.6; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import RealSites from '../components/RealSites.astro';
import Icon from '../components/Icon.astro';
import QuoteBand from '../components/QuoteBand.astro';
import KumaonMap from '../components/KumaonMap.astro';
import ProjectDiagram from '../components/ProjectDiagram.astro';
import { projects } from '../data/projects';
import { belts } from '../data/geo';
import { qa } from '../data/faq';
import { site, tel, tel2, wa, mailto } from '../data/site';

const title = 'JCB Backhoe Loader Rental in Kumaon, Uttarakhand | RBE Capital Equip.';
const description =
  'JCB backhoe loader on rent with operator for contractors and developers in Kumaon, Uttarakhand, from Haldwani and Majkhali (Ranikhet).';

const concerns = [
  { q: 'Will the machine actually reach my site?', a: 'It starts from Haldwani or from Majkhali near Ranikhet — one base at the foot of the hills, one inside them. Route, travel method and arrival date are fixed before you commit, including narrow hill roads and the last stretch to site.', href: '/kumaon-service-area/#deployment', l: 'How deployment is planned' },
  { q: 'What if it breaks down mid-project?', a: 'How a breakdown is reported, who attends and what happens if a repair runs long is agreed in writing before dispatch. The machine is checked before it leaves for your site.', href: '/why-rbe/#support', l: 'How support works' },
  { q: 'Will it stay on my project?', a: 'RBE rents for a minimum of 15 days — monthly or for the project phase — with an operator every time. It is set up for project work, not hourly jobs.', href: '/backhoe-loader-rental/#rental-terms', l: 'Rental terms' },
  { q: 'Is a backhoe loader right for this job?', a: 'Often, but not always. RBE has a rock breaker for rock in drains and edges. If your scope really needs a tracked excavator, you will hear that before any machine is sent.', href: '/backhoe-loader-rental/#when-not', l: 'When to choose an excavator' },
];

// Buyer segments: each one leads to the page written for it.
const audiences = [
  { t: 'Contractors', items: ['PWD & public-works', 'Road & highway', 'Civil & building', 'Infrastructure & EPC', 'Utility', 'Bridge & river works'], href: '/contractors/', l: 'Send project requirement' },
  { t: 'Developers', items: ['Hotels', 'Resorts', 'Industrial developments', 'Commercial developments', 'Real-estate developments'], href: '/developers/', l: 'Discuss site development' },
  { t: 'Project teams', items: ['Site engineers', 'Procurement managers', 'Project managers', 'Main contractors', 'Subcontractors'], href: '/contractors/#teams', l: 'What each role needs' },
  { t: 'Emergency work', items: ['Landslide & slip clearance', 'Boulder & rock clearance', 'Flood & drainage earthwork', 'Road-blockage clearance'], href: '/emergency-earthwork/', l: 'Call Site Coordination' },
];

const answers = ['haldwani', 'ranikhet', 'minimum', 'cost', 'hill-roads'].map(qa);

// Real site photographs — one per project type, each used once on the site. Captions stay neutral:
// no photo is attributed to a named project without evidence.
const photos: Record<string, string> = {
  'road-construction': 'JCB backhoe loader clearing excavated soil during hill road widening, with road workers standing by',
  'hill-cutting': 'JCB backhoe loader on hill-cutting earthwork along a mountain road above a lake',
  'site-development': 'JCB backhoe loader excavating a hillside plot for site development beside a newly built house',
  'dam-bridge': 'JCB backhoe loader doing riverbank earthwork beside a bridge under construction, workers in hard hats nearby',
  'trenching': 'JCB backhoe loader digging a utility trench alongside a stone retaining wall',
  'infrastructure': 'JCB backhoe loader excavating for site works in front of a large institutional building, workers in hard hats nearby',
};
---
<Base title={title} description={description}>
  <Hero />
  <RealSites />

  <!-- At a glance: who, what, where, which projects, how to enquire -->
  <section class="glance dark-2" aria-labelledby="h-glance">
    <div class="wrap">
      <h2 id="h-glance" class="sr-only">RBE Capital Equip. at a glance</h2>
      <dl class="glance__grid">
        <div><dt>Who we serve</dt><dd><a href="/contractors/">Contractors</a>, <a href="/developers/">developers</a> and project teams building in Kumaon</dd></div>
        <div><dt>What we provide</dt><dd><a href="/backhoe-loader-rental/">JCB backhoe loader</a> with operator · 15-day minimum · rock breaker available</dd></div>
        <div><dt>Where</dt><dd>Kumaon, Uttarakhand — from <a href="/jcb-on-rent-haldwani/">Haldwani</a> and <a href="/jcb-on-rent-ranikhet-almora/">Majkhali (Ranikhet)</a></dd></div>
        <div><dt>Projects</dt><dd><a href="/project-solutions/">Roads, hill cutting, site development, utilities, bridges</a> · <a href="/emergency-earthwork/">emergency clearance</a></dd></div>
        <div><dt>Enquire</dt><dd>{site.phoneLabel} <a href={tel}>{site.phoneDisplay}</a><br />{site.phone2Label} <a href={tel2}>{site.phone2Display}</a><br /><a href="/contact/">Project enquiry form</a></dd></div>
      </dl>
    </div>
  </section>

  <!-- Problem → answer -->
  <section class="section paper" aria-labelledby="h-concerns">
    <div class="wrap">
      <div class="split">
        <div class="split__l">
          <p class="eyebrow rv"><span class="idx">01</span>The real questions</p>
          <h2 id="h-concerns" class="rv">Your project can’t stop because a machine <span class="serif">didn’t turn up.</span></h2>
          <p class="lead muted rv rv-d1" style="margin-top:28px">Finding a backhoe loader is easy. Finding one that reaches a hill site on the day you planned, keeps working through the project, and is backed by someone who picks up the phone — that is the actual requirement.</p>
        </div>
        <ol class="concerns">
          {concerns.map((c, i) => (
            <li class="rv">
              <span class="mono concerns__n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{c.q}</h3>
                <p class="muted">{c.a}</p>
                <a class="inline" href={c.href}>{c.l} →</a>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="section--tight dark-2 aud" aria-labelledby="h-aud">
    <div class="wrap">
      <div class="aud__head">
        <p class="eyebrow"><span class="idx">02</span>Who we work with</p>
        <h2 id="h-aud" class="rv">Equipment for project teams, <span class="serif">not one-off jobs.</span></h2>
        <p class="muted rv aud__lead">Minimum hire is 15 days. If you need a machine for a few hours, a local hourly operator will suit you better. Teams from Delhi NCR and beyond are welcome — RBE’s head office is in Faridabad.</p>
      </div>
      <ul class="aud__list">
        {audiences.map((a) => (
          <li class="rv">
            <h3><a href={a.href}>{a.t}</a></h3>
            <ul class="aud__items">{a.items.map((x) => <li>{x}</li>)}</ul>
            <a class="inline aud__go" href={a.href}>{a.l} →</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Project types: horizontal track -->
  <section class="section paper proj" aria-labelledby="h-proj">
    <div class="wrap proj__head">
      <div>
        <p class="eyebrow"><span class="idx">03</span>Project solutions</p>
        <h2 id="h-proj" class="rv">Organised around <span class="serif">your</span> project type.</h2>
      </div>
      <p class="muted proj__intro rv">Each project type has its own site realities in Kumaon. Here is where a backhoe loader earns its place — and where it doesn’t.</p>
    </div>
    <div class="proj__track" tabindex="0" aria-label="Project types, scroll horizontally">
      {projects.map((p, i) => (
        <a class="proj__card" href={`/project-solutions/#${p.id}`}>
          <span class="mono proj__i">{String(i + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}</span>
          {photos[p.id] && (
            <figure class="proj__photo">
              <img src={`/projects/${p.id}-800.webp`} srcset={`/projects/${p.id}-480.webp 480w, /projects/${p.id}-800.webp 800w`} sizes="(max-width: 500px) 76vw, 352px" width="800" height="533" loading="lazy" decoding="async" alt={photos[p.id]} />
              <figcaption class="mono">On-site equipment</figcaption>
            </figure>
          )}
          <div class="proj__fig"><ProjectDiagram kind={p.kind} label={`Cross-section: ${p.title}`} /></div>
          <h3>{p.title}</h3>
          <p class="muted">{p.short}</p>
          <span class="proj__go">See tasks and limits <Icon name="arrow" /></span>
        </a>
      ))}
    </div>
  </section>

  <!-- Kumaon -->
  <section class="section dark geo" aria-labelledby="h-geo">
    <div class="wrap geo__grid">
      <div class="geo__copy">
        <p class="eyebrow"><span class="idx">04</span>Kumaon service area</p>
        <h2 id="h-geo" class="rv">From 200 m in the Terai to 2,300 m on the ridges. <span class="serif">Two bases, three kinds of site.</span></h2>
        <p class="muted rv" style="margin-top:24px">The machine is dispatched from Haldwani (about 425 m), where the hill roads begin, and from Majkhali on the Ranikhet–Almora road (about 1,800 m). A site in Pantnagar and a site above Mukteshwar still need different planning — so mobilisation is planned around the belt your project sits in.</p>
        <dl class="geo__belts">
          {Object.values(belts).map((b) => (
            <div class="rv"><dt>{b.title}</dt><dd><span class="mono">{b.short}</span>{b.realities[0]}</dd></div>
          ))}
        </dl>
        <p class="geo__hubs"><a class="inline" href="/jcb-on-rent-haldwani/">JCB on rent from Haldwani</a> — Haldwani, Rudrapur, Kashipur, Bhimtal, Bhowali, Nainital<br /><a class="inline" href="/jcb-on-rent-ranikhet-almora/">JCB on rent from Majkhali</a> — Ranikhet, Almora, Bageshwar, Pithoragarh</p>
        <a class="btn btn--ghost" href="/kumaon-service-area/">Locations and deployment planning <Icon name="arrow" /></a>
      </div>
      <div class="geo__map rv"><KumaonMap /></div>
    </div>
  </section>

  <!-- Process -->
  <section class="section stone" aria-labelledby="h-proc">
    <div class="wrap">
      <div class="proc__head">
        <p class="eyebrow"><span class="idx">05</span>How rental works</p>
        <h2 id="h-proc" class="rv">From your first message to a working machine.</h2>
      </div>
      <ol class="proc">
        <li class="rv"><b>Requirement</b><span>Call, WhatsApp or send the form — site, work, dates, duration.</span></li>
        <li class="rv rv-d1"><b>Site check</b><span>Location, access road and working conditions.</span></li>
        <li class="rv rv-d2"><b>Confirmation</b><span>Period, hours, operator, diesel, breakdown terms — in writing.</span></li>
        <li class="rv rv-d3"><b>Mobilisation</b><span>Machine checked, route and arrival date fixed.</span></li>
        <li class="rv"><b>On site</b><span>Operator and your site team agree the daily plan.</span></li>
        <li class="rv rv-d1"><b>Support</b><span>One contact for breakdowns, extension or return.</span></li>
      </ol>
      <div class="btn-row" style="margin-top:48px">
        <a class="btn" href="/contact/">Start with your requirement <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href="/how-rental-works/">The full process</a>
      </div>
    </div>
  </section>

  <!-- Who you deal with: facts, not adjectives -->
  <section class="section paper roto" aria-labelledby="h-roto">
    <div class="wrap roto__grid">
      <p class="roto__big rv" aria-hidden="true">RBE</p>
      <div>
        <p class="eyebrow"><span class="idx">06</span>Who you would be dealing with</p>
        <h2 id="h-roto" class="rv">An enterprise of <span class="serif">Rotoblast Engineering.</span></h2>
        <div class="prose measure rv" style="margin-top:28px">
          <p>RBE Capital Equip. is a company, not an individual putting a machine on hire. It has a head office in Faridabad, two deployment bases in Kumaon, and a fixed way of working that is written down before your machine moves.</p>
          <p>What that gives a project team: availability confirmed in writing, a machine checked before dispatch, breakdown handling agreed up front, and one person to call. <a href="/why-rbe/">What you can expect from RBE</a>.</p>
        </div>
      <dl class="spec facts rv" aria-label="RBE Capital Equip. — key facts">
        <div><dt>Equipment</dt><dd>JCB backhoe loader · model to suit the job</dd></div>
        <div><dt>Operator</dt><dd>Always included</dd></div>
        <div><dt>Minimum hire</dt><dd>15 days</dd></div>
        <div><dt>Hire basis</dt><dd>Monthly or project phase</dd></div>
        <div><dt>Rock breaker</dt><dd>Available</dd></div>
        <div><dt>GST invoice</dt><dd>On request</dd></div>
        <div><dt>Dispatched from</dt><dd>Haldwani · Majkhali (Ranikhet)</dd></div>
        <div><dt>Head office</dt><dd>{site.headOffice.display}</dd></div>
        <div><dt>{site.phoneLabel}</dt><dd><a href={tel}>{site.phoneDisplay}</a> · <a href={wa()} rel="noopener">WhatsApp</a></dd></div>
        <div><dt>{site.phone2Label}</dt><dd><a href={tel2}>{site.phone2Display}</a></dd></div>
        <div><dt>Email</dt><dd><a href={mailto}>{site.email}</a></dd></div>
      </dl>
      </div>
    </div>
  </section>

  <!-- Direct answers -->
  <section class="section--tight paper" aria-labelledby="h-ans">
    <div class="wrap ans">
      <div>
        <p class="eyebrow"><span class="idx">07</span>Straight answers</p>
        <h2 id="h-ans">Questions contractors ask before they hire.</h2>
        <a class="btn btn--ghost" style="margin-top:32px" href="/knowledge/">All questions and answers <Icon name="arrow" /></a>
      </div>
      <div>
        {answers.map((x) => (
          <div class="answer">
            <h3>{x.q}</h3>
            <div class="prose muted" set:html={x.html ?? x.a} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <QuoteBand waText="Hello RBE Capital Equip., I want to discuss backhoe loader availability for a project in Kumaon." />
</Base>

<style>
  .split { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(40px, 7vw, 120px); align-items: start; }
  .split__l { position: sticky; top: calc(var(--header-h) + 40px); }
  .concerns { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-l); }
  .concerns li { display: grid; grid-template-columns: 56px 1fr; gap: 12px; padding: 32px 0; border-bottom: 1px solid var(--line-l); }
  .concerns__n { color: var(--copper); padding-top: 6px; }
  .concerns h3 { margin-bottom: 12px; }
  .concerns p { margin-bottom: 12px; }

  .aud__head { display: grid; grid-template-columns: 1fr 2fr; gap: 32px; align-items: end; margin-bottom: 56px; }
  .aud__head h2 { font-size: clamp(1.8rem, 3.6vw, 3.2rem); }
  .aud__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line-d); }
  .aud__list h3 a { text-decoration: none; } .aud__list h3 a:hover { color: var(--copper-hi); }
  .aud__items { list-style: none; margin: 0 0 16px; padding: 0; color: var(--on-dark-2); font-size: .92rem; }
  .aud__items li { padding: 5px 0; border-bottom: 1px dashed var(--line-d); }
  .aud__go { font-size: .92rem; font-weight: 500; }
  .glance { padding-block: clamp(36px, 4vw, 56px); border-top: 1px solid var(--line-d); }
  .glance__grid { display: grid; grid-template-columns: repeat(5, 1fr); margin: 0; }
  .glance__grid div { padding: 4px 20px 4px 0; }
  .glance__grid div + div { padding-left: 20px; border-left: 1px solid var(--line-d); }
  .glance dt { font-family: var(--f-mono); font-size: .68rem; text-transform: uppercase; letter-spacing: .12em; color: var(--copper-hi); margin-bottom: 8px; }
  .glance dd { margin: 0; font-size: .95rem; color: var(--on-dark-2); }
  .glance dd a { color: var(--on-dark); text-decoration-color: var(--copper); text-underline-offset: .2em; }
  .glance dd a:hover { color: var(--copper-hi); }
  .geo__hubs { margin: -16px 0 32px; font-size: .95rem; color: var(--on-dark-2); line-height: 1.9; }
  .aud__list > li { padding: 28px 24px 28px 0; border-right: 1px solid var(--line-d); }
  .aud__list > li + li { padding-left: 24px; }
  .aud__list > li:last-child { border-right: 0; }
  .aud__list h3 { font-size: 1.08rem; margin-bottom: 12px; }
  .aud__list p { font-size: .92rem; }

  .proj__head { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: end; margin-bottom: 48px; }
  .proj__intro { max-width: 42ch; }
  .proj__track { display: grid; grid-auto-flow: column; grid-auto-columns: min(400px, 82vw); gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px var(--gutter) 24px; scroll-padding-inline: var(--gutter); scrollbar-width: thin; scrollbar-color: var(--copper) transparent; }
  .proj__card { scroll-snap-align: start; display: flex; flex-direction: column; gap: 14px; padding: 24px; background: var(--stone); text-decoration: none; border: 1px solid transparent; transition: border-color .3s var(--ease), background .3s var(--ease); }
  .proj__card:hover { border-color: var(--copper); background: var(--stone-2); }
  .proj__i { color: var(--on-light-2); font-size: .7rem; }
  .proj__photo { position: relative; margin: 0; aspect-ratio: 3 / 2; overflow: hidden; background: var(--stone-2); }
  .proj__photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .proj__card:hover .proj__photo img { transform: scale(1.03); }
  .proj__photo figcaption { position: absolute; left: 0; bottom: 0; padding: 5px 10px; background: rgba(14,16,18,.72); color: var(--on-dark); font-size: .64rem; letter-spacing: .12em; text-transform: uppercase; }
  .proj__fig { color: var(--on-light); padding: 8px 0 12px; border-bottom: 1px solid var(--line-l); }
  .proj__card h3 { font-size: 1.3rem; }
  .proj__card p { font-size: .95rem; flex: 1; }
  .proj__go { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: .92rem; }
  .proj__go :global(svg) { width: 18px; color: var(--copper); transition: transform .3s var(--ease); }
  .proj__card:hover .proj__go :global(svg) { transform: translateX(4px); }

  .geo__grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .geo__copy h2 { font-size: clamp(1.9rem, 3.4vw, 3rem); }
  .geo__belts { margin: 36px 0 40px; border-top: 1px solid var(--line-d); }
  .geo__belts div { padding: 18px 0; border-bottom: 1px solid var(--line-d); display: grid; gap: 6px; }
  .geo__belts dt { font-weight: 600; }
  .geo__belts dd { margin: 0; color: var(--on-dark-2); font-size: .95rem; display: grid; gap: 4px; }
  .geo__belts .mono { font-size: .72rem; color: var(--copper-hi); letter-spacing: .04em; }

  .proc__head { display: grid; grid-template-columns: 1fr 1.6fr; gap: 32px; align-items: end; margin-bottom: 56px; }
  .proc__head h2 { font-size: clamp(1.9rem, 3.6vw, 3.2rem); }
  .proc { list-style: none; counter-reset: s; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); position: relative; }
  .proc::before { content: ''; position: absolute; left: 0; right: 0; top: 11px; height: 1px; background: var(--line-l); }
  .proc li { counter-increment: s; position: relative; padding: 40px 18px 0 0; display: grid; gap: 8px; }
  .proc li::before { content: '0' counter(s); position: absolute; top: 0; left: 0; background: var(--stone); padding-right: 10px; font-family: var(--f-mono); font-size: .75rem; color: var(--copper-lo); }
  .proc li::after { content: ''; position: absolute; top: 8px; left: 30px; width: 7px; height: 7px; background: var(--copper); }
  .proc b { font-family: var(--f-display); font-stretch: 110%; font-size: 1.15rem; font-weight: 650; }
  .proc span { color: var(--on-light-2); font-size: .92rem; }

  .roto__grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .aud__lead { grid-column: 2; max-width: 52ch; margin-top: -12px; }
  .facts { margin-top: 36px; }
  .facts dd a { text-decoration: none; } .facts dd a:hover { color: var(--copper-lo); }
  .roto__grid .roto__big { position: sticky; top: calc(var(--header-h) + 40px); align-self: start; }
  .roto__big { margin: 0; font-family: var(--f-display); font-weight: 800; font-stretch: 125%; font-size: clamp(6rem, 18vw, 17rem); letter-spacing: -0.06em; line-height: .8; color: transparent; -webkit-text-stroke: 1px var(--on-light-2); opacity: .5; }

  .ans { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(32px, 6vw, 96px); }
  .ans h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); }

  @media (max-width: 1100px) {
    .aud__list { grid-template-columns: 1fr 1fr; }
    .glance__grid { grid-template-columns: 1fr 1fr; gap: 20px 0; }
    .glance__grid div:nth-child(odd) { padding-left: 0; border-left: 0; }
    .aud__list > li, .aud__list > li + li { padding: 24px 20px 24px 0; border-right: 0; border-bottom: 1px solid var(--line-d); }
    .proc { grid-template-columns: repeat(3, 1fr); row-gap: 40px; }
  }
  @media (max-width: 860px) {
    .split, .aud__head, .proj__head, .geo__grid, .proc__head, .roto__grid, .ans { grid-template-columns: 1fr; }
    .split__l { position: static; }
    .concerns li { grid-template-columns: 40px 1fr; }
    .aud__list { grid-template-columns: 1fr; }
    .glance__grid { grid-template-columns: 1fr; }
    .glance__grid div, .glance__grid div + div { padding: 0 0 16px; border-left: 0; border-bottom: 1px solid var(--line-d); }
    .proc { grid-template-columns: 1fr; row-gap: 0; }
    .proc::before { left: 11px; right: auto; top: 0; bottom: 0; width: 1px; height: auto; }
    .proc li { padding: 0 0 28px 48px; }
    .proc li::before { top: 0; left: 0; padding: 0 0 6px; }
    .proc li::after { left: 8px; top: 24px; }
    .aud__lead { grid-column: 1; margin-top: 0; }
    .roto__big { font-size: 7rem; }
    .roto__grid .roto__big { position: static; }
  }
</style>

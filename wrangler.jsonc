{
  "name": "rbe-capital-equip",
  "compatibility_date": "2026-10-02",
  // Runs only for /api/* (enquiry form + analytics events); everything else is served
  // straight from dist/ as static assets, unchanged. RESEND_API_KEY is a Worker secret.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENQUIRY_TO": "sales@rbecapitalgroup.in",
    "ENQUIRY_FROM": "RBE Capital Equip. Website <website@rbecapitalgroup.in>"
  },
  "observability": { "enabled": true }
}
